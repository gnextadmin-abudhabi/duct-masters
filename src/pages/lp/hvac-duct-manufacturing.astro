  </main>

  <footer class="bg-brand-950 pb-24 text-center text-xs text-brand-300 md:pb-8">
    <div class="mx-auto max-w-7xl border-t border-white/10 px-4 pt-6">
      © {new Date().getFullYear()} {business.legalName}
    </div>
  </footer>

  <!-- MOBILE STICKY ACTION BAR -->
  <nav class="fixed inset-x-0 bottom-0 z-50 grid grid-cols-4 border-t border-stone-200 bg-white shadow-[0_-4px_20px_rgba(0,0,0,0.08)] md:hidden" aria-label="Quick contact">
    <a href={business.phoneHref} data-track="call_click" data-cta-position="sticky_bar" class="flex flex-col items-center gap-1 py-2.5 text-[11px] font-semibold text-brand-900">
      <Icon name="lucide:phone" class="size-5 text-brand-500" />
      <Tx en="Call" ar="اتصال" />
    </a>
    <a href={waEn} data-href-en={waEn} data-href-ar={waAr} target="_blank" rel="noopener" data-track="whatsapp_click" data-cta-position="sticky_bar" class="flex flex-col items-center gap-1 py-2.5 text-[11px] font-semibold text-brand-900">
      <Icon name="lucide:message-circle" class="size-5 text-[#25D366]" />
      <Tx en="WhatsApp" ar="واتساب" />
    </a>
    <a href={business.googleMapsUrl} target="_blank" rel="noopener" data-track="location_click" data-cta-position="sticky_bar" class="flex flex-col items-center gap-1 py-2.5 text-[11px] font-semibold text-brand-900">
      <Icon name="lucide:map-pin" class="size-5 text-brand-500" />
      <Tx en="Location" ar="الموقع" />
    </a>
    <a href="#quote" class="flex flex-col items-center gap-1 bg-gradient-to-br from-accent-500 to-brand-500 py-2.5 text-[11px] font-semibold text-white">
      <Icon name="lucide:file-text" class="size-5" />
      <Tx en="Quote" ar="عرض سعر" />
    </a>
  </nav>

  <script is:inline>
    (() => {
      const form = document.getElementById('lp-quote-form');
      const statusEl = document.getElementById('lp-form-status');
      if (!form || !statusEl) return;
      const ar = () => document.documentElement.lang === 'ar';
      const msg = {
        sending: ['Sending…', 'جارٍ الإرسال…'],
        ok: ['Thank you! Your request has been received — our team will contact you within one business day.', 'شكراً لك! تم استلام طلبك — سيتواصل معك فريقنا خلال يوم عمل واحد.'],
        missing: ['Please fill in your name, phone, email and project details.', 'يرجى إدخال الاسم والهاتف والبريد الإلكتروني وتفاصيل المشروع.'],
        email: ['Please enter a valid email address.', 'يرجى إدخال بريد إلكتروني صحيح.'],
        fail: ['Sorry, something went wrong. Please call or WhatsApp us.', 'عذراً، حدث خطأ. يرجى الاتصال بنا أو مراسلتنا عبر واتساب.'],
      };
      const t = (k) => msg[k][ar() ? 1 : 0];
      const show = (ok, text) => {
        statusEl.textContent = text;
        statusEl.className = 'rounded-xl px-4 py-3 text-sm font-medium';
        statusEl.style.cssText = ok
          ? 'border:1px solid #bbf7d0;background:#f0fdf4;color:#166534'
          : 'border:1px solid #fecaca;background:#fef2f2;color:#b91c1c';
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const val = (k) => String(fd.get(k) || '').trim();
        if (!val('name') || !val('phone') || !val('email') || !val('message')) return show(false, t('missing'));
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(val('email'))) return show(false, t('email'));

        const btn = form.querySelector('button[type="submit"]');
        const original = btn.innerHTML;
        btn.disabled = true; btn.style.opacity = '0.7'; btn.textContent = t('sending');
        statusEl.className = 'hidden';
        try {
          const res = await fetch('/api/contact', { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
          const data = await res.json().catch(() => ({}));
          if (res.ok && data.ok) {
            // Conversion — fires only after the server has accepted the enquiry.
            // user_data feeds Google Ads enhanced conversions (hashed by Google's tag).
            window.dmTrack('quote_submit', {
              cta_position: 'quote_form',
              form_service: val('service'),
              user_data: { email: val('email'), phone_number: val('phone').replace(/[^\d+]/g, '') },
            });
            form.reset();
            show(true, t('ok'));
          } else {
            show(false, ar() ? t('fail') : (data.error || t('fail')));
          }
        } catch {
          show(false, t('fail'));
        } finally {
          btn.disabled = false; btn.style.opacity = ''; btn.innerHTML = original;
        }
      });
    })();
  </script>
</LandingLayout>
