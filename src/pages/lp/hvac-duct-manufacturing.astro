    <!-- FAQ -->
    <section class="py-16 lg:py-24">
      <div class="mx-auto max-w-3xl px-4 lg:px-8">
        <Tx tag="h2" class="text-center font-display text-3xl tracking-tight text-brand-900 sm:text-4xl" en="Frequently Asked Questions" ar="الأسئلة الشائعة" />
        <div class="mt-10 space-y-3">
          {faqs.map((f, i) => (
            <details class="group rounded-2xl border border-stone-200 bg-white p-5 open:shadow-md" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-brand-900">
