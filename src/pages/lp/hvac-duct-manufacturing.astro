        <ul class="mt-6 flex flex-wrap justify-center gap-3">
          {sectors.map((s) => (
            <li class="rounded-full border border-stone-200 bg-stone-50 px-4 py-2 text-sm font-medium text-brand-900"><Tx en={s.en} ar={s.ar} /></li>
