              </summary>
              <Tx tag="p" class="mt-3 text-sm leading-relaxed text-stone-600" en={f.aEn} ar={f.aAr} />
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- LOCATION + FINAL CTA -->
    <section class="bg-brand-950 py-16 text-white lg:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 lg:grid-cols-2 lg:items-center lg:px-8">
        <div>
          <Tx tag="h2" class="font-display text-3xl tracking-tight sm:text-4xl" en="Ready to Price Your Ductwork?" ar="جاهز لتسعير مجاري الهواء لمشروعك؟" />
          <Tx tag="p" class="mt-4 text-brand-100" en="Send your drawings or BOQ, call our team, or visit the factory in Musaffah." ar="أرسل الرسومات أو جدول الكميات، أو اتصل بفريقنا، أو زر المصنع في مصفح." />

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#quote" class={btnPrimary}>
              <Icon name="lucide:file-text" class="size-4" />
              <Tx en="Get a Quote" ar="اطلب عرض سعر" />
            </a>
            <a href={business.phoneHref} data-track="call_click" data-cta-position="footer_cta" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/25 px-6 py-3.5 text-sm font-semibold transition-colors hover:bg-white/10">
              <Icon name="lucide:phone" class="size-4" />
              <span dir="ltr">{business.phone}</span>
            </a>
            <a href={waEn} data-href-en={waEn} data-href-ar={waAr} target="_blank" rel="noopener" data-track="whatsapp_click" data-cta-position="footer_cta" class={btnWhatsapp}>
              <Icon name="lucide:message-circle" class="size-4" />
              <Tx en="WhatsApp" ar="واتساب" />
            </a>
          </div>

          <dl class="mt-10 space-y-4 text-sm">
            <div class="flex gap-3">
              <Icon name="lucide:map-pin" class="mt-0.5 size-5 shrink-0 text-accent-400" />
              <div>
                <dt class="font-semibold"><Tx en="Factory" ar="المصنع" /></dt>
                <dd class="text-brand-200"><Tx en={`${business.address.street}, ${business.address.city}, UAE`} ar="M-40، مصفح، أبوظبي، الإمارات" /></dd>
              </div>
            </div>
            <div class="flex gap-3">
              <Icon name="lucide:clock" class="mt-0.5 size-5 shrink-0 text-accent-400" />
              <div>
                <dt class="font-semibold"><Tx en="Working Hours" ar="ساعات العمل" /></dt>
                <dd class="text-brand-200"><Tx en="Mon – Sat: 8:00 AM – 5:00 PM · Sunday closed" ar="الاثنين – السبت: 8:00 ص – 5:00 م · الأحد مغلق" /></dd>
              </div>
            </div>
          </dl>
        </div>

        <div class="overflow-hidden rounded-3xl border border-white/10 bg-brand-900">
          <iframe src={mapEmbed} title="Duct Masters location — M-40 Musaffah, Abu Dhabi" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="h-72 w-full border-0 sm:h-80"></iframe>
          <a href={business.googleMapsUrl} target="_blank" rel="noopener" data-track="location_click" data-cta-position="map" class="flex items-center justify-center gap-2 bg-white/5 px-4 py-4 text-sm font-semibold transition-colors hover:bg-white/10">
            <Icon name="lucide:navigation" class="size-4" />
