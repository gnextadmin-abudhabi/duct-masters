---
// Google Ads landing page — HVAC duct manufacturing (EN/AR).
// noindex + excluded from the sitemap so it doesn't compete with the homepage
// in organic search. Arabic ad groups can link to ?lang=ar.
// The quote form posts to /api/contact — the same endpoint as /contact/.
import LandingLayout from '../../layouts/LandingLayout.astro';
import Tx from '../../components/lp/Tx.astro';
import { Icon } from 'astro-icon/components';
import { business, yearsInBusiness } from '../../data/business';
import { businessEntity, serviceSchema } from '../../lib/schema';

const years = yearsInBusiness();
const waNumber = business.whatsapp.replace('https://wa.me/', '');
const waEn = `https://wa.me/${waNumber}?text=${encodeURIComponent('Hello Duct Masters, I would like a quote for HVAC duct manufacturing.')}`;
const waAr = `https://wa.me/${waNumber}?text=${encodeURIComponent('مرحباً دكت ماسترز، أود الحصول على عرض سعر لتصنيع مجاري الهواء.')}`;
const mapEmbed = `https://www.google.com/maps?q=${business.coordinates.lat},${business.coordinates.lng}&z=15&output=embed`;

const heroPoints = [
  { en: 'ISO-certified quality system', ar: 'نظام جودة معتمد بشهادة ISO' },
  { en: 'Built to SMACNA & your project specs', ar: 'وفق معايير SMACNA ومواصفات مشروعك' },
  { en: 'Quote response within 1 business day', ar: 'الرد على طلب السعر خلال يوم عمل واحد' },
];

const stats = [
  { value: 'ISO', en: 'Certified manufacturer', ar: 'مصنّع معتمد' },
  { value: '100%', en: 'In-house production', ar: 'إنتاج داخلي' },
  { value: `${years}+`, en: 'Years in the UAE', ar: 'سنوات في الإمارات' },
  { value: '0.5–6', unitEn: 'mm', unitAr: 'مم', en: 'Sheet thickness range', ar: 'نطاق سماكة الصفائح' },
];

const products = [
  {
    img: '/images/gallery/workers-fabricating-hvac-ducts.webp',
    en: 'Rectangular Ductwork', ar: 'مجاري هواء مستطيلة',
    dEn: 'GI rectangular ducts in all sizes and gauges, Pittsburgh seam locked and reinforced to spec.',
    dAr: 'مجاري مستطيلة من الحديد المجلفن بجميع المقاسات والسماكات، بوصلات بيتسبرغ وتدعيم حسب المواصفات.',
  },
  {
    img: '/images/gallery/technician-inspecting-hvac-duct.webp',
    en: 'Round & Oval Ducts', ar: 'مجاري دائرية وبيضاوية',
    dEn: 'Round and oval duct sections for supply, return and exhaust air systems.',
    dAr: 'مقاطع مجاري دائرية وبيضاوية لأنظمة الهواء المزوّد والراجع والعادم.',
  },
  {
    img: '/images/gallery/technicians-working-on-duct-sections.webp',
    en: 'Stainless Steel & Aluminium', ar: 'ستانلس ستيل وألمنيوم',
    dEn: 'Stainless steel and aluminium ducting for kitchen exhaust, corrosive and special applications.',
    dAr: 'مجاري من الستانلس ستيل والألمنيوم لشفط المطابخ والبيئات المسببة للتآكل والتطبيقات الخاصة.',
  },
  {
    img: '/images/gallery/technicians-preparing-duct-sections.webp',
    en: 'Fittings & Accessories', ar: 'القطع والملحقات',
    dEn: 'Elbows, reducers, take-offs, transitions, dampers and plenums made to your drawings.',
    dAr: 'أكواع ومخفضات ووصلات تفرع وقطع انتقالية ودامبرات وصناديق توزيع حسب رسوماتك.',
  },
];

const specs = [
  { kEn: 'Materials', kAr: 'المواد', vEn: 'Galvanized iron (GI), stainless steel, aluminium', vAr: 'حديد مجلفن، ستانلس ستيل، ألمنيوم' },
  { kEn: 'Sheet thickness', kAr: 'سماكة الصفائح', vEn: '0.5 mm – 6 mm', vAr: '0.5 مم – 6 مم' },
  { kEn: 'Standard', kAr: 'المعيار', vEn: 'SMACNA + project specification', vAr: 'SMACNA + مواصفات المشروع' },
  { kEn: 'Seams & joints', kAr: 'الوصلات', vEn: 'Pittsburgh seam lock, reinforced to spec', vAr: 'وصلات بيتسبرغ مع تدعيم حسب المواصفات' },
  { kEn: 'Systems', kAr: 'الأنظمة', vEn: 'Supply, return, fresh air & exhaust', vAr: 'هواء مزوّد وراجع ونقي وعادم' },
  { kEn: 'Testing', kAr: 'الاختبار', vEn: 'Dimensional checks, leakage testing where required', vAr: 'فحص الأبعاد واختبار التسرب عند الحاجة' },
  { kEn: 'Delivery', kAr: 'التسليم', vEn: 'Abu Dhabi, Al Ain & across the UAE', vAr: 'أبوظبي والعين وجميع أنحاء الإمارات' },
];

const steps = [
  { icon: 'lucide:file-search', en: 'Drawing Review', ar: 'مراجعة الرسومات', dEn: 'We check your HVAC drawings for sizing, routing and fabrication requirements.', dAr: 'نراجع رسومات التكييف لتحديد المقاسات والمسارات ومتطلبات التصنيع.' },
  { icon: 'lucide:layers', en: 'Material Prep', ar: 'تجهيز المواد', dEn: 'GI, stainless or aluminium sheet selected and prepared to the specified gauge.', dAr: 'اختيار وتجهيز صفائح الحديد المجلفن أو الستانلس ستيل أو الألمنيوم بالسماكة المطلوبة.' },
  { icon: 'lucide:cog', en: 'Fabrication', ar: 'التصنيع', dEn: 'Cutting, CNC forming and seam locking — all on our own machines in Musaffah.', dAr: 'القص والتشكيل بماكينات CNC وإقفال الوصلات — كلها على ماكيناتنا في مصفح.' },
  { icon: 'lucide:clipboard-check', en: 'Quality Check', ar: 'فحص الجودة', dEn: 'Dimensional checks, leakage testing where required, and final QC before dispatch.', dAr: 'فحص الأبعاد واختبار التسرب عند الحاجة وفحص نهائي قبل الشحن.' },
  { icon: 'lucide:truck', en: 'Site Delivery', ar: 'التسليم للموقع', dEn: 'Packed and delivered to your project anywhere in Abu Dhabi and the UAE.', dAr: 'تغليف وتسليم إلى موقع مشروعك في أي مكان في أبوظبي والإمارات.' },
];

const sectors = [
  { icon: 'lucide:hard-hat', en: 'MEP & HVAC Contractors', ar: 'مقاولو الأعمال الكهروميكانيكية والتكييف' },
  { icon: 'lucide:building-2', en: 'Commercial Buildings', ar: 'المباني التجارية' },
  { icon: 'lucide:factory', en: 'Industrial Facilities', ar: 'المنشآت الصناعية' },
  { icon: 'lucide:construction', en: 'Construction Projects', ar: 'مشاريع الإنشاءات' },
  { icon: 'lucide:landmark', en: 'Infrastructure', ar: 'البنية التحتية' },
  { icon: 'lucide:wrench', en: 'Facility Management', ar: 'إدارة المرافق' },
];

const faqs = [
  {
    qEn: 'What materials do you use for HVAC ducts?', qAr: 'ما المواد التي تستخدمونها لمجاري التكييف؟',
    aEn: 'We fabricate in galvanized iron (GI), stainless steel and aluminium, in sheet thicknesses from 0.5 mm to 6 mm, and can advise on the right material for your application.',
    aAr: 'نصنّع من الحديد المجلفن والستانلس ستيل والألمنيوم بسماكات من 0.5 مم إلى 6 مم، ونقدّم المشورة لاختيار المادة المناسبة لتطبيقك.',
  },
  {
    qEn: 'Do you manufacture everything in-house?', qAr: 'هل تصنّعون كل شيء داخلياً؟',
    aEn: 'Yes. Drawing review, cutting, forming, assembly, quality control and delivery are all managed by our own team from our facility in M-40, Musaffah.',
    aAr: 'نعم. مراجعة الرسومات والقص والتشكيل والتجميع وفحص الجودة والتسليم تتم جميعها بواسطة فريقنا من منشأتنا في M-40 مصفح.',
  },
  {
    qEn: 'Which standards do you follow?', qAr: 'ما المعايير التي تتبعونها؟',
    aEn: 'Our ductwork is built to SMACNA and your project specifications, including gauge selection, reinforcement, sealing and dimensional accuracy. Duct Masters is ISO certified.',
    aAr: 'نصنّع مجاري الهواء وفق معايير SMACNA ومواصفات مشروعك، بما في ذلك اختيار السماكة والتدعيم والإحكام ودقة الأبعاد. دكت ماسترز حاصلة على شهادة ISO.',
  },
  {
    qEn: 'How quickly will I get a quotation?', qAr: 'متى أحصل على عرض السعر؟',
    aEn: 'Send your drawings or BOQ and we normally confirm feasibility within one business day, followed by a detailed quotation with production and delivery schedule.',
    aAr: 'أرسل الرسومات أو جدول الكميات وعادةً نؤكد الجدوى خلال يوم عمل واحد، ثم نرسل عرض سعر مفصلاً مع جدول الإنتاج والتسليم.',
  },
  {
    qEn: 'Do you deliver outside Abu Dhabi?', qAr: 'هل توصلون خارج أبوظبي؟',
    aEn: 'Yes. We deliver to project sites across Abu Dhabi, Al Ain and the rest of the UAE.',
    aAr: 'نعم. نوصل إلى مواقع المشاريع في أبوظبي والعين وباقي إمارات الدولة.',
  },
];

const services = [
  { value: 'Rectangular GI ducts', ar: 'مجاري مستطيلة مجلفنة' },
  { value: 'Round / oval ducts', ar: 'مجاري دائرية / بيضاوية' },
  { value: 'Stainless / aluminium ducts', ar: 'مجاري ستانلس / ألمنيوم' },
  { value: 'Fittings & accessories', ar: 'القطع والملحقات' },
  { value: 'Complete project supply', ar: 'توريد مشروع كامل' },
];

const pageTitle = 'HVAC Duct Manufacturing Abu Dhabi | Get a Quote';
const pageDescription = `ISO-certified HVAC duct manufacturer in Musaffah, Abu Dhabi. GI, stainless & aluminium ductwork built in-house to SMACNA. Call ${business.phone}.`;

// Business + Service + FAQ, so the page carries the same entity as the homepage
const schema = [
  { '@context': 'https://schema.org', ...businessEntity() },
  serviceSchema({
    url: '/lp/hvac-duct-manufacturing/',
    name: 'HVAC Duct Manufacturing in Abu Dhabi',
    serviceType: 'HVAC Duct Manufacturing',
    description: pageDescription,
    image: '/images/gallery/duct-manufacturing-workshop.webp',
    areaServed: { '@type': 'AdministrativeArea', name: 'Abu Dhabi' },
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.qEn,
      acceptedAnswer: { '@type': 'Answer', text: f.aEn },
    })),
  },
];

const btnPrimary = 'btn-shine inline-flex items-center justify-center gap-2 rounded-xl bg-accent-500 px-6 py-3.5 text-sm font-semibold text-brand-950 shadow-lg shadow-accent-500/25 transition-all hover:-translate-y-0.5 hover:bg-accent-400';
const btnGhost = 'inline-flex items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/5 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-white/10';
const btnWhatsapp = 'inline-flex items-center justify-center gap-2 rounded-xl bg-[#25D366] px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-[#25D366]/20 transition-all hover:-translate-y-0.5 hover:bg-[#1ebe5a]';
const field = 'peer block w-full rounded-lg border border-stone-300 bg-stone-50 px-3.5 py-3 text-sm text-stone-900 placeholder-stone-400 transition-colors focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20';
const label = 'mb-1.5 block text-xs font-semibold uppercase tracking-wide text-stone-500';
const eyebrow = 'inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em]';
---

<LandingLayout title={pageTitle} description={pageDescription} lpName="hvac-duct-manufacturing" schema={schema}>

  <!-- TOP BAR -->
  <header class="sticky top-0 z-40 border-b border-white/10 bg-brand-950/90 backdrop-blur-md">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-2 lg:px-8">
      <img src="/images/logo-footer.png" alt="Duct Masters" class="-my-2 h-14 w-auto sm:h-16" width="420" height="272" />
      <div class="flex items-center gap-2">
        <button type="button" data-lang-toggle class="rounded-lg px-3 py-2 text-xs font-semibold text-brand-200 transition-colors hover:bg-white/10 hover:text-white">
          <span data-toggle-label>العربية</span>
        </button>
        <a href={business.phoneHref} data-track="call_click" data-cta-position="header" class="inline-flex items-center gap-2 rounded-lg border border-white/15 px-3 py-2 text-sm font-semibold text-white transition-colors hover:bg-white/10">
          <Icon name="lucide:phone" class="size-4 text-accent-400" />
          <span dir="ltr" class="hidden sm:inline">{business.phone}</span>
          <Tx en="Call" ar="اتصال" class="sm:hidden" />
        </a>
        <a href="#quote" data-track="quote_cta_click" data-cta-position="header" class="hidden rounded-lg bg-accent-500 px-4 py-2 text-sm font-semibold text-brand-950 transition-colors hover:bg-accent-400 md:inline-flex">
          <Tx en="Get a Quote" ar="اطلب عرض سعر" />
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO + FORM -->
    <section class="relative overflow-hidden bg-brand-950 text-white">
      <div class="absolute inset-0">
        <img src="/images/gallery/duct-manufacturing-workshop.webp" alt="" class="h-full w-full object-cover opacity-40" width="1200" height="670" fetchpriority="high" />
        <div class="absolute inset-0 bg-gradient-to-r from-brand-950 via-brand-950/95 to-brand-950/70 rtl:bg-gradient-to-l"></div>
        <div class="absolute -top-40 start-1/3 h-[32rem] w-[32rem] rounded-full bg-brand-500/25 blur-[140px]"></div>
      </div>

      <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 pt-10 pb-14 min-[960px]:grid-cols-[1.05fr_1fr] lg:gap-16 lg:px-8 lg:pt-16 lg:pb-20">
        <div>
          <span class={`${eyebrow} rounded-full border border-accent-400/25 bg-accent-400/10 px-3.5 py-1.5 text-accent-300`}>
            <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-accent-400 opacity-60"></span><span class="relative inline-flex size-2 rounded-full bg-accent-400"></span></span>
            <Tx en="Factory-direct · M-40 Musaffah" ar="من المصنع مباشرة · M-40 مصفح" />
          </span>

          <h1 class="mt-6 font-display text-[2.6rem] leading-[1.05] tracking-tight sm:text-6xl lg:text-[4.2rem]">
            <Tx en="HVAC Duct Manufacturing" ar="تصنيع مجاري التكييف" class="block" />
            <Tx en="in Abu Dhabi" ar="في أبوظبي" class="block text-accent-400" />
          </h1>

          <Tx tag="p" class="mt-6 max-w-xl text-lg leading-relaxed text-brand-100"
            en="GI, stainless steel and aluminium ductwork and fittings — fabricated 100% in-house and delivered to your site on schedule."
            ar="مجاري هواء وقطع من الحديد المجلفن والستانلس ستيل والألمنيوم — مصنّعة داخلياً بالكامل وتُسلَّم لموقعك في الموعد." />

          <ul class="mt-7 space-y-3">
            {heroPoints.map((p) => (
              <li class="flex items-center gap-3 text-[15px] font-medium text-white">
                <Icon name="lucide:circle-check" class="size-5 shrink-0 text-accent-400" />
                <Tx en={p.en} ar={p.ar} />
              </li>
            ))}
          </ul>

          <div class="mt-9 flex flex-wrap gap-3">
            <a href={business.phoneHref} data-track="call_click" data-cta-position="hero" class={btnGhost}>
              <Icon name="lucide:phone" class="size-4" />
              <span dir="ltr">{business.phone}</span>
            </a>
            <a href={waEn} data-href-en={waEn} data-href-ar={waAr} target="_blank" rel="noopener" data-track="whatsapp_click" data-cta-position="hero" class={btnWhatsapp}>
              <Icon name="lucide:message-circle" class="size-4" />
              <Tx en="WhatsApp Us" ar="راسلنا واتساب" />
            </a>
          </div>
        </div>

        <!-- Quote form -->
        <div id="quote" class="scroll-mt-20">
          <div class="relative">
            <div class="pointer-events-none absolute -inset-3 rounded-[2rem] bg-gradient-to-br from-accent-400/30 via-brand-500/10 to-transparent blur-2xl"></div>
            <div class="relative overflow-hidden rounded-2xl bg-white text-stone-900 shadow-2xl shadow-black/40">
              <div class="flex items-center justify-between gap-3 border-b border-stone-200 bg-stone-50 px-6 py-3 sm:px-7">
                <span class="font-mono text-[11px] font-semibold uppercase tracking-widest text-brand-500">RFQ · HVAC-DUCT</span>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-700 ring-1 ring-emerald-200">
                  <Icon name="lucide:clock" class="size-3" />
                  <Tx en="Reply in 1 business day" ar="رد خلال يوم عمل" />
                </span>
              </div>

              <div class="p-6 sm:p-7">
                <Tx tag="h2" class="font-display text-2xl leading-tight text-brand-900 sm:text-[1.7rem]" en="Get a Free Ductwork Quote" ar="احصل على عرض سعر مجاني" />
                <Tx tag="p" class="mt-1.5 text-sm text-stone-500" en="Tell us what you need — sizes, quantities or just the project name." ar="أخبرنا بما تحتاجه — المقاسات أو الكميات أو اسم المشروع فقط." />

                <form id="lp-quote-form" class="mt-6 space-y-4" action="/api/contact" method="POST" novalidate>
                  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
                  <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                      <label for="lp-name" class={label}><Tx en="Full name *" ar="الاسم الكامل *" /></label>
                      <input id="lp-name" name="name" type="text" maxlength="100" required autocomplete="name" class={field} />
                    </div>
                    <div>
                      <label for="lp-company" class={label}><Tx en="Company" ar="الشركة" /></label>
                      <input id="lp-company" name="company" type="text" maxlength="150" autocomplete="organization" class={field} />
                    </div>
                  </div>
                  <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                      <label for="lp-phone" class={label}><Tx en="Phone / WhatsApp *" ar="الهاتف / واتساب *" /></label>
                      <input id="lp-phone" name="phone" type="tel" maxlength="30" required autocomplete="tel" dir="ltr" placeholder="+971 5X XXX XXXX" class={`${field} rtl:text-right`} />
                    </div>
                    <div>
                      <label for="lp-email" class={label}><Tx en="Email *" ar="البريد الإلكتروني *" /></label>
                      <input id="lp-email" name="email" type="email" maxlength="254" required autocomplete="email" dir="ltr" placeholder="you@company.com" class={`${field} rtl:text-right`} />
                    </div>
                  </div>

                  <fieldset>
                    <legend class={label}><Tx en="What do you need?" ar="ماذا تحتاج؟" /></legend>
                    <div class="flex flex-wrap gap-2">
                      {services.map((s, i) => (
                        <label class="cursor-pointer">
                          <input type="radio" name="service" value={`LP HVAC Duct - ${s.value}`} checked={i === 0} class="peer sr-only" />
                          <span class="inline-flex rounded-full border border-stone-300 px-3 py-1.5 text-xs font-medium text-stone-600 transition-colors peer-checked:border-brand-500 peer-checked:bg-brand-500 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-brand-500/30 hover:border-brand-400">
                            <Tx en={s.value} ar={s.ar} />
                          </span>
                        </label>
                      ))}
                    </div>
                  </fieldset>

                  <div>
                    <label for="lp-message" class={label}><Tx en="Project details *" ar="تفاصيل المشروع *" /></label>
                    <textarea id="lp-message" name="message" rows="3" maxlength="5000" required class={field}
                      placeholder="Project location, quantities, sizes, timeline…"
                      data-lang-placeholder-en="Project location, quantities, sizes, timeline…"
                      data-lang-placeholder-ar="موقع المشروع، الكميات، المقاسات، الجدول الزمني…"></textarea>
                  </div>

                  <p id="lp-form-status" class="hidden" role="status" aria-live="polite"></p>

                  <button type="submit" class="btn-shine group inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-900 px-6 py-4 text-base font-semibold text-white shadow-lg shadow-brand-900/25 transition-all hover:-translate-y-0.5 hover:bg-brand-800">
                    <Tx en="Request My Quote" ar="أرسل طلب عرض السعر" />
                    <Icon name="lucide:arrow-right" class="size-4 transition-transform group-hover:translate-x-1 rtl-flip" />
                  </button>
                  <p class="flex items-center justify-center gap-1.5 text-xs text-stone-500">
                    <Icon name="lucide:lock" class="size-3.5" />
                    <Tx en="Your details are only used to prepare your quotation." ar="نستخدم بياناتك فقط لإعداد عرض السعر." />
                  </p>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Stats rail -->
      <div class="relative border-t border-white/10 bg-brand-950/60 backdrop-blur">
        <dl class="mx-auto grid max-w-7xl grid-cols-2 divide-white/10 px-4 lg:grid-cols-4 lg:divide-x lg:px-8 rtl:lg:divide-x-reverse">
          {stats.map((s) => (
            <div class="px-2 py-5 lg:px-6">
              <dt class="sr-only"><Tx en={s.en} ar={s.ar} /></dt>
              <dd class="font-display text-3xl text-white sm:text-4xl" dir="ltr">
                {s.value}{s.unitEn && <Tx en={s.unitEn} ar={s.unitAr!} class="ms-1 font-body text-base text-brand-300" />}
              </dd>
              <Tx tag="p" class="mt-1 text-xs font-medium uppercase tracking-wider text-brand-300" en={s.en} ar={s.ar} />
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- SECTORS TICKER -->
    <section class="border-b border-stone-200 bg-white py-5" aria-label="Sectors we serve">
      <div class="marquee-mask overflow-hidden" dir="ltr">
        <ul class="flex w-max gap-10 motion-safe:animate-[marquee_40s_linear_infinite] hover:[animation-play-state:paused]">
          {[...sectors, ...sectors].map((s, i) => (
            <li class="flex items-center gap-2.5 whitespace-nowrap text-sm font-semibold text-brand-900" aria-hidden={i >= sectors.length ? 'true' : undefined}>
              <Icon name={s.icon} class="size-5 text-brand-400" />
