  <script is:inline>
    (() => {
      const form = document.getElementById('lp-quote-form');
      const statusEl = document.getElementById('lp-form-status');
      if (!form || !statusEl) return;
      const ar = () => document.documentElement.lang === 'ar';
      const msg = {
        sending: ['Sending…', 'جارٍ الإرسال…'],
        ok: ["Thank you! Your inquiry has been sent — we'll get back to you within one business day.", 'شكراً لك! تم إرسال طلبك — سنتواصل معك خلال يوم عمل واحد.'],
        missing: ['Please fill in your name, phone, email and project details.', 'يرجى إدخال الاسم والهاتف والبريد الإلكتروني وتفاصيل المشروع.'],
        email: ['Please enter a valid email address.', 'يرجى إدخال بريد إلكتروني صحيح.'],
        fail: ['Sorry, something went wrong. Please call or WhatsApp us.', 'عذراً، حدث خطأ. يرجى الاتصال بنا أو مراسلتنا عبر واتساب.'],
        network: ['Network error. Please try again, or call/WhatsApp us.', 'خطأ في الاتصال. يرجى المحاولة مرة أخرى أو الاتصال بنا / مراسلتنا عبر واتساب.'],
      };
      const t = (k) => msg[k][ar() ? 1 : 0];
      const show = (ok, text) => {
        statusEl.textContent = text;
        statusEl.className = 'rounded-xl px-4 py-3 text-sm font-medium';
        statusEl.style.cssText = ok
          ? 'border:1px solid #bbf7d0;background:#f0fdf4;color:#166534'
          : 'border:1px solid #fecaca;background:#fef2f2;color:#b91c1c';
      };

      // Enhanced conversions need E.164: 050 123 4567 / 00971… / 971… → +97150…
      const toE164 = (raw) => {
        let p = raw.replace(/[^\d+]/g, '').replace(/^00/, '+');
        if (/^0\d{8,9}$/.test(p)) p = '+971' + p.slice(1);
        else if (/^971\d{8,9}$/.test(p)) p = '+' + p;
        else if (/^5\d{8}$/.test(p)) p = '+971' + p;
        return p;
      };

      // Same request as the /contact/ form: multipart POST to /api/contact, JSON { ok, error } back.
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const val = (k) => String(fd.get(k) || '').trim();
        if (!val('name') || !val('phone') || !val('email') || !val('message')) return show(false, t('missing'));
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(val('email'))) return show(false, t('email'));

        const btn = form.querySelector('button[type="submit"]');
        const original = btn.innerHTML;
        btn.disabled = true; btn.style.opacity = '0.7'; btn.textContent = t('sending');
        statusEl.className = 'hidden';
        try {
          const res = await fetch('/api/contact', { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
          const data = await res.json().catch(() => ({}));
          if (res.ok && data.ok) {
            // The server accepted the enquiry. The thank-you page fires the
            // quote_submit conversion from these details, then deletes them.
            try {
              sessionStorage.setItem('dm-lead', JSON.stringify({
                service: val('service'),
                email: val('email'),
                phone: toE164(val('phone')),
              }));
            } catch {}
            form.reset();
            show(true, t('ok'));
            location.href = '/lp/hvac-duct-manufacturing/thank-you/' + (ar() ? '?lang=ar' : '');
            return;
          } else {
            show(false, ar() ? t('fail') : (data.error || t('fail')));
          }
        } catch {
          show(false, t('network'));
        } finally {
          btn.disabled = false; btn.style.opacity = ''; btn.innerHTML = original;
        }
      });
    })();
  </script>
