---
import { business } from '../data/business';
import { getLang, languageUrls, htmlLang, ogLocale, AR_INDEXABLE } from '../i18n';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const lang = getLang(Astro.url);
const SITE_NAME = lang === 'ar' ? 'دكت ماسترز' : business.name;
const DEFAULT_OG_IMAGE = business.ogImage;

const {
  title: rawTitle,
  description,
  canonicalUrl,
  ogImage,
  schema,
  noindex = false,
} = Astro.props;

// Auto-append site name when missing, but only if the title stays within
// the ~60 characters Google shows in results
const MAX_TITLE = 60;
const branded = `${rawTitle} | ${SITE_NAME}`;
const title = rawTitle.includes(SITE_NAME) || branded.length > MAX_TITLE
  ? rawTitle
  : branded;

// Auto-construct canonical from the current request URL when not provided
const canonical = canonicalUrl || new URL(Astro.url.pathname, Astro.site).href;

// Language alternates (hreflang) — every page exists at / and /ar/.
// Skipped on noindex pages (landing pages, 404) and while Arabic is hidden.
const alternates = noindex || !AR_INDEXABLE ? null : languageUrls(Astro.url, Astro.site);
const otherLang = lang === 'ar' ? 'en' : 'ar';

// Resolve the OG image to an absolute URL
const ogImageUrl = new URL(ogImage || DEFAULT_OG_IMAGE, Astro.site).href;
---

<!-- Primary Meta -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

{alternates && (
  <>
    <link rel="alternate" hreflang={htmlLang.en} href={alternates.en} />
    <link rel="alternate" hreflang={htmlLang.ar} href={alternates.ar} />
    <link rel="alternate" hreflang="x-default" href={alternates.en} />
  </>
)}

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={ogLocale[lang]} />
<meta property="og:locale:alternate" content={ogLocale[otherLang]} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- JSON-LD Schema -->
{schema && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
)}
