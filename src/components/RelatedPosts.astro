---
// Blog posts tagged with this service (frontmatter `services`).
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { blogUrl } from '../lib/urls';

interface Props {
  serviceSlug: string;
}

const { serviceSlug } = Astro.props;
const posts = (await getCollection('blog'))
  .filter((post) => post.data.services.includes(serviceSlug))
  .sort((a, b) => b.data.publishDate.localeCompare(a.data.publishDate))
  .slice(0, 3);
---

{posts.length > 0 && (
  <section class="border-t border-stone-200/60 bg-stone-50 py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <h2 data-reveal class="font-display text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">Guides &amp; Insights</h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-3">
        {posts.map((post) => (
          <li>
            <a href={blogUrl(post.id)} class="group flex h-full flex-col rounded-2xl border border-stone-200 bg-white p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-lg hover:shadow-brand-900/5">
              <span class="font-semibold text-brand-900 group-hover:text-brand-700">{post.data.title}</span>
              <span class="mt-2 text-sm text-stone-600">{post.data.description}</span>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600">
                Read guide <Icon name="lucide:arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
