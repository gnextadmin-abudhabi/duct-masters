---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { business } from '../../data/business';
import { getLang, localizePath, htmlLang } from '../../i18n';
import { getBusiness, getService } from '../../i18n/localize';

const lang = getLang(Astro.url);
const isAr = lang === 'ar';
const biz = getBusiness(lang);

const contactSchema = isAr
  ? {
      '@context': 'https://schema.org',
      '@type': 'ContactPage',
      url: new URL(localizePath('/contact/', lang), business.website).href,
      name: 'تواصل مع دكت ماسترز',
      description: `تواصل مع دكت ماسترز في مصفح، أبوظبي. اتصل على ${business.phone} أو راسلنا على ${business.email} للحصول على عروض أسعار تصنيع مجاري التكييف وتشكيل الصفائح المعدنية.`,
      inLanguage: htmlLang[lang],
      about: { '@id': `${business.website}/#business` },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'ContactPage',
      name: `Contact ${business.name}`,
      description: `Contact ${business.name} in Musaffah, Abu Dhabi. Call ${business.phone} or email ${business.email} for HVAC duct manufacturing and sheet metal fabrication quotations.`,
      about: { '@id': `${business.website}/#business` },
    };

// Option values go into the team's email — keep them unchanged
const serviceOptions: [string, string][] = [
  ['sheet-metal-fabrication', 'Sheet Metal Fabrication'],
  ['duct-fabrication', 'HVAC Duct Manufacturing'],
  ['laser-cutting', 'Laser Cutting Services'],
  ['cnc-forming', 'CNC Metal Forming'],
  ['welding-services', 'Industrial Welding'],
  ['metal-rolling-punching', 'Metal Rolling & Punching'],
  ['custom-industrial-fabrication', 'Custom Industrial Fabrication'],
  ['powder-coating-finishing', 'Powder Coating & Finishing'],
  ['design-engineering', 'Duct System Design & Engineering'],
  ['stainless-steel-duct-fabrication', 'Stainless Steel Duct Fabrication'],
  ['supply-delivery', 'Duct Supply & Installation'],
];
const options = serviceOptions.map(([value, en]) => ({
  value,
  label: isAr ? getService(value, 'ar')?.name ?? en : en,
}));

const t = isAr
  ? {
      title: 'تواصل مع دكت ماسترز | مصنع مجاري التكييف أبوظبي',
      description: `تواصل مع دكت ماسترز، M-40 مصفح، أبوظبي. اتصل ${business.phone} أو راسلنا على ${business.email} لطلب عرض سعر لمجاري الهواء والأعمال المعدنية.`,
      crumb: 'اتصل بنا',
      h1: 'اتصل بنا',
      heroText: 'تواصل مع فريقنا للحصول على عروض أسعار تصنيع مجاري التكييف وتشكيل الصفائح المعدنية، أو للاستفسار عن مشروعك.',
      touchTitle: 'تواصل معنا',
      touchText: 'أرسل لنا الرسومات والمواصفات الخاصة بمشروعك لتحصل على عرض سعر تنافسي. نرد عادةً خلال يوم عمل واحد.',
      address: 'العنوان',
      maps: 'عرض الموقع على خرائط جوجل',
      phone: 'الهاتف',
      mobile: 'الجوال / واتساب:',
      email: 'البريد الإلكتروني',
      hours: 'ساعات العمل',
      formTitle: 'أرسل لنا رسالة',
      formText: 'أضف تفاصيل مشروعك أو الرسومات لنتمكن من إعداد عرض السعر بشكل أسرع.',
      name: 'الاسم الكامل *',
      namePh: 'اسمك',
      emailLabel: 'البريد الإلكتروني *',
      phoneLabel: 'الهاتف',
      company: 'الشركة',
      companyPh: 'اسم شركتك',
      service: 'الخدمة المطلوبة',
      servicePh: 'اختر الخدمة',
      message: 'تفاصيل المشروع *',
      messagePh: 'صِف متطلبات مشروعك والكميات والمواد، وأي رسومات أو مواصفات متوفرة لديك…',
      submit: 'إرسال الاستفسار',
    }
  : {
      title: `Contact ${business.name} | Duct Manufacturer Abu Dhabi`,
      description: `Contact ${business.name}, M-40 Musaffah, Abu Dhabi. Call ${business.phone} or email ${business.email} for ductwork and fabrication quotes.`,
      crumb: 'Contact',
      h1: 'Contact Us',
      heroText: 'Get in touch with our team for HVAC duct manufacturing, sheet metal fabrication quotations, or project inquiries.',
      touchTitle: 'Get in Touch',
      touchText: 'Send us your project drawings and specifications for a competitive quotation. We typically respond within one business day.',
      address: 'Address',
      maps: 'View on Google Maps',
      phone: 'Phone',
      mobile: 'Mobile / WhatsApp:',
      email: 'Email',
      hours: 'Business Hours',
      formTitle: 'Send Us a Message',
      formText: 'Include your project details or upload drawings for a faster quotation.',
      name: 'Full Name *',
      namePh: 'Your name',
      emailLabel: 'Email *',
      phoneLabel: 'Phone',
      company: 'Company',
      companyPh: 'Your company name',
      service: 'Service Interested In',
      servicePh: 'Select a service',
      message: 'Project Details *',
      messagePh: 'Describe your project requirements, quantities, materials, and any drawings or specifications you have…',
      submit: 'Send Inquiry',
    };

// Messages used by the client script below
const msgs = isAr
  ? {
      lang: 'ar',
      sending: 'جارٍ الإرسال…',
      success: 'شكراً لك! تم إرسال استفسارك، وسنتواصل معك خلال يوم عمل واحد.',
      missing: 'يرجى إدخال الاسم والبريد الإلكتروني وتفاصيل المشروع.',
      invalidEmail: 'يرجى إدخال بريد إلكتروني صحيح.',
      tooMany: 'طلبات كثيرة، يرجى الانتظار قليلاً ثم المحاولة مرة أخرى.',
      error: 'عذراً، حدث خطأ. يرجى الاتصال بنا أو مراسلتنا عبر واتساب.',
      network: 'تعذّر الاتصال بالشبكة. يرجى المحاولة مرة أخرى، أو الاتصال بنا أو مراسلتنا عبر واتساب.',
    }
  : {
      lang: 'en',
      sending: 'Sending…',
      success: "Thank you! Your inquiry has been sent — we'll get back to you within one business day.",
      error: 'Sorry, something went wrong. Please call or WhatsApp us.',
      network: 'Network error. Please try again, or call/WhatsApp us.',
    };
---

<BaseLayout
  title={t.title}
  description={t.description}
  schema={contactSchema}
  breadcrumbs={[{ label: t.crumb }]}
>
  <!-- Hero -->
  <section class="relative -mt-28 flex min-h-[60vh] items-center overflow-hidden bg-brand-950 pt-32 pb-24 lg:-mt-[140px] lg:min-h-[64vh] lg:pt-40 lg:pb-28">
    <div class="absolute inset-0">
      <img src="/images/gallery/engineers-reviewing-drawings.webp" alt="" class="h-full w-full object-cover" width="1200" height="670" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-b from-brand-950/92 via-brand-950/82 to-brand-950/96"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_40%,_rgba(46,104,156,0.28),_transparent_70%)]"></div>
      <div class="blueprint-grid-dark absolute inset-0 opacity-30"></div>
    </div>
    <div class="relative mx-auto w-full max-w-3xl px-5 text-center lg:px-8">
      <span data-reveal class="mx-auto inline-flex size-14 items-center justify-center rounded-2xl border border-white/20 bg-white/10 text-white shadow-lg backdrop-blur-sm">
        <Icon name="lucide:mail" class="size-7" />
      </span>
      <h1 data-reveal style="--reveal-delay: 80ms" class="mt-6 font-display text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">{t.h1}</h1>
      <p data-reveal style="--reveal-delay: 160ms" class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-brand-100">
        {t.heroText}
      </p>
    </div>
  </section>

  <section class="relative overflow-hidden bg-stone-50 py-24 lg:py-32">
    <div class="dot-grid absolute inset-0 opacity-40"></div>
    <div class="absolute -top-20 end-0 h-96 w-96 rounded-full bg-accent-500/10 blur-[120px]"></div>
    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
        <!-- Contact Info -->
        <div>
          <h2 data-reveal class="font-display text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">{t.touchTitle}</h2>
          <p data-reveal style="--reveal-delay: 80ms" class="mt-3 text-stone-600">
            {t.touchText}
          </p>

          <div class="mt-8 space-y-5">
            <div data-reveal data-spotlight style="--reveal-delay: 120ms" class="group spotlight-card gradient-border flex items-start gap-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-900/10">
              <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-accent-500/15 to-brand-500/10 ring-1 ring-brand-100 transition-all duration-300 group-hover:-rotate-6 group-hover:scale-110 group-hover:from-accent-500 group-hover:to-brand-500">
                <Icon name="lucide:map-pin" class="size-6 text-brand-600 transition-colors group-hover:text-white" />
              </div>
              <div>
                <h3 class="font-semibold text-brand-900">{t.address}</h3>
                <p class="mt-1 text-stone-600">
                  {biz.address.street}<br />
                  {biz.address.city}{isAr ? '، ' : ', '}{biz.address.country}
                </p>
                <a
                  href={business.googleMapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-1 inline-flex min-h-6 items-center gap-1 text-sm font-medium text-brand-600 hover:text-brand-700"
                >
                  <Icon name="lucide:external-link" class="size-3.5" />
                  {t.maps}
                </a>
              </div>
            </div>

            <div data-reveal data-spotlight style="--reveal-delay: 180ms" class="group spotlight-card gradient-border flex items-start gap-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-900/10">
              <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-accent-500/15 to-brand-500/10 ring-1 ring-brand-100 transition-all duration-300 group-hover:-rotate-6 group-hover:scale-110 group-hover:from-accent-500 group-hover:to-brand-500">
                <Icon name="lucide:phone" class="size-6 text-brand-600 transition-colors group-hover:text-white" />
              </div>
              <div>
                <h3 class="font-semibold text-brand-900">{t.phone}</h3>
                <p class="mt-1 text-stone-600">
                  <a href={business.phoneHref} class="hover:text-brand-600" dir="ltr">{business.phone}</a>
                </p>
                <p class="mt-0.5 text-sm text-stone-500">{t.mobile} <span dir="ltr">{business.phoneSecondary}</span></p>
              </div>
            </div>

            <div data-reveal data-spotlight style="--reveal-delay: 240ms" class="group spotlight-card gradient-border flex items-start gap-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-900/10">
              <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-accent-500/15 to-brand-500/10 ring-1 ring-brand-100 transition-all duration-300 group-hover:-rotate-6 group-hover:scale-110 group-hover:from-accent-500 group-hover:to-brand-500">
                <Icon name="lucide:mail" class="size-6 text-brand-600 transition-colors group-hover:text-white" />
              </div>
              <div>
                <h3 class="font-semibold text-brand-900">{t.email}</h3>
                <p class="mt-1 text-stone-600">
                  <a href={`mailto:${business.email}`} class="hover:text-brand-600" dir="ltr">{business.email}</a>
                </p>
              </div>
            </div>

            <div data-reveal data-spotlight style="--reveal-delay: 300ms" class="group spotlight-card gradient-border flex items-start gap-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-900/10">
              <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-accent-500/15 to-brand-500/10 ring-1 ring-brand-100 transition-all duration-300 group-hover:-rotate-6 group-hover:scale-110 group-hover:from-accent-500 group-hover:to-brand-500">
                <Icon name="lucide:clock" class="size-6 text-brand-600 transition-colors group-hover:text-white" />
              </div>
              <div>
                <h3 class="font-semibold text-brand-900">{t.hours}</h3>
                <div class="mt-1 text-stone-600">
                  {biz.hours.map((schedule) => (
                    <p>{schedule.days}: {schedule.hours}</p>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div data-reveal={isAr ? 'left' : 'right'} class="relative">
          <div class="pointer-events-none absolute -inset-4 rounded-[2.5rem] bg-gradient-to-br from-accent-500/15 to-brand-500/10 blur-2xl"></div>
          <div class="relative rounded-3xl border border-stone-200 bg-white p-8 shadow-2xl shadow-brand-900/10">
            <h2 class="font-display text-xl font-bold tracking-tight text-brand-900">{t.formTitle}</h2>
            <p class="mt-2 text-sm text-stone-500">
              {t.formText}
            </p>

            <form id="contact-form" class="mt-6 space-y-5" action="/api/contact" method="POST" data-msgs={JSON.stringify(msgs)}>
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
              <div>
                <label for="name" class="block text-sm font-medium text-stone-700">{t.name}</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  maxlength="100"
                  required
                  class="mt-1 block w-full rounded-xl border border-stone-300 px-4 py-2.5 text-sm text-stone-900 placeholder-stone-400 transition-colors focus:border-accent-500 focus:ring-1 focus:ring-accent-500"
                  placeholder={t.namePh}
                />
              </div>

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="email" class="block text-sm font-medium text-stone-700">{t.emailLabel}</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    maxlength="254"
                    required
                    dir="ltr"
                    class="mt-1 block w-full rounded-xl border border-stone-300 px-4 py-2.5 text-sm text-stone-900 placeholder-stone-400 transition-colors focus:border-accent-500 focus:ring-1 focus:ring-accent-500 rtl:text-end"
                    placeholder="you@company.com"
                  />
                </div>
                <div>
                  <label for="phone" class="block text-sm font-medium text-stone-700">{t.phoneLabel}</label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    maxlength="30"
                    dir="ltr"
                    class="mt-1 block w-full rounded-xl border border-stone-300 px-4 py-2.5 text-sm text-stone-900 placeholder-stone-400 transition-colors focus:border-accent-500 focus:ring-1 focus:ring-accent-500 rtl:text-end"
                    placeholder="+971"
                  />
                </div>
              </div>

              <div>
                <label for="company" class="block text-sm font-medium text-stone-700">{t.company}</label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  maxlength="150"
                  class="mt-1 block w-full rounded-xl border border-stone-300 px-4 py-2.5 text-sm text-stone-900 placeholder-stone-400 transition-colors focus:border-accent-500 focus:ring-1 focus:ring-accent-500"
                  placeholder={t.companyPh}
                />
              </div>

              <div>
                <label for="service" class="block text-sm font-medium text-stone-700">{t.service}</label>
                <select
                  id="service"
                  name="service"
                  class="mt-1 block w-full rounded-xl border border-stone-300 px-4 py-2.5 text-sm text-stone-900 transition-colors focus:border-accent-500 focus:ring-1 focus:ring-accent-500"
                >
                  <option value="">{t.servicePh}</option>
                  {options.map((o) => <option value={o.value}>{o.label}</option>)}
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-stone-700">{t.message}</label>
                <textarea
                  id="message"
                  name="message"
                  maxlength="5000"
                  rows="5"
                  required
                  class="mt-1 block w-full rounded-xl border border-stone-300 px-4 py-2.5 text-sm text-stone-900 placeholder-stone-400 transition-colors focus:border-accent-500 focus:ring-1 focus:ring-accent-500"
                  placeholder={t.messagePh}
                ></textarea>
              </div>

              <p id="form-status" class="hidden" role="status" aria-live="polite"></p>

              <button
                type="submit"
                class="btn-shine group inline-flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-br from-accent-500 to-brand-500 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-accent-600/30 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-accent-600/50"
              >
                <Icon name="lucide:send" class="size-4 transition-transform group-hover:translate-x-0.5 rtl:rotate-180 rtl:group-hover:-translate-x-0.5" />
                {t.submit}
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    type Msgs = {
      lang: 'en' | 'ar';
      sending: string;
      success: string;
      error: string;
      network: string;
      missing?: string;
      invalidEmail?: string;
      tooMany?: string;
    };
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('form-status');
    if (form && statusEl) {
      const m: Msgs = JSON.parse(form.dataset.msgs || '{}');
      // The API answers in English; on Arabic pages show an Arabic message instead
      const errorMessage = (status: number, error: unknown): string => {
        const text = typeof error === 'string' ? error : '';
        if (m.lang !== 'ar') return text || m.error;
        if (status === 429 || /too many/i.test(text)) return m.tooMany || m.error;
        if (/fill in/i.test(text)) return m.missing || m.error;
        if (/valid email/i.test(text)) return m.invalidEmail || m.error;
        return m.error;
      };
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        const original = btn ? btn.innerHTML : '';
        if (btn) { btn.disabled = true; btn.style.opacity = '0.7'; btn.textContent = m.sending; }
        statusEl.className = 'hidden';
        const show = (ok: boolean, msg: string) => {
          statusEl.textContent = msg;
          statusEl.className = 'rounded-xl px-4 py-3 text-sm font-medium';
          statusEl.style.cssText = ok
            ? 'border:1px solid #bbf7d0;background:#f0fdf4;color:#166534'
            : 'border:1px solid #fecaca;background:#fef2f2;color:#b91c1c';
        };
        try {
          const res = await fetch('/api/contact', { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
          const data = await res.json().catch(() => ({}));
          if (res.ok && data.ok) {
            form.reset();
            show(true, m.success);
          } else {
            show(false, errorMessage(res.status, data.error));
          }
        } catch {
          show(false, m.network);
        } finally {
          if (btn) { btn.disabled = false; btn.style.opacity = ''; btn.innerHTML = original; }
        }
      });
    }
  </script>
</BaseLayout>
