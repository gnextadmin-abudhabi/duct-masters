---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { business, yearsInBusiness } from '../../data/business';
import { serviceUrl, areaUrl, contactUrl, aboutUrl } from '../../lib/urls';
import { businessEntity, businessRef, WEBSITE_ID } from '../../lib/schema';
import { getLang, localizePath, htmlLang } from '../../i18n';
import { getBusiness, getServices, getAreas } from '../../i18n/localize';

const lang = getLang(Astro.url);
const isAr = lang === 'ar';
const biz = getBusiness(lang);
const services = getServices(lang);
const areas = getAreas(lang);
const years = yearsInBusiness();
const est = business.yearEstablished;

const galleryImages = [
  { src: '/images/gallery/laser-machine-operator.webp', alt: isAr ? 'ماكينة قص بالليزر CNC أثناء العمل في دكت ماسترز' : 'CNC laser cutting machine in operation at Duct Masters' },
  { src: '/images/gallery/technician-inspecting-hvac-duct.webp', alt: isAr ? 'فحص جودة مجاري هواء التكييف' : 'Quality inspection of HVAC ductwork' },
  { src: '/images/gallery/workers-collaborating-metal-fabrication.webp', alt: isAr ? 'تصنيع مكوّنات معدنية في منشأتنا بمصفح' : 'Metal component fabrication at Musaffah facility' },
  { src: '/images/gallery/engineers-reviewing-drawings.webp', alt: isAr ? 'مهندسون يراجعون الرسومات التنفيذية' : 'Engineers reviewing fabrication drawings' },
  { src: '/images/gallery/logo-on-uniform.webp', alt: isAr ? 'فريق مصنع دكت ماسترز' : 'Duct Masters factory team' },
  { src: '/images/gallery/preparing-components.webp', alt: isAr ? 'تجهيز المكوّنات المعدنية للتصنيع' : 'Preparing metal components for fabrication' },
  { src: '/images/gallery/factory-uniforms.webp', alt: isAr ? 'فريق ورشة دكت ماسترز بالزي الموحد' : 'Duct Masters workshop team in uniform' },
  { src: '/images/gallery/workers-handling-metal-sheets.webp', alt: isAr ? 'التعامل مع الصفائح المعدنية في منشأة دكت ماسترز' : 'Handling sheet metal at Duct Masters facility' },
];

const stats = [
  { count: years, suffix: '+', label: isAr ? 'سنوات الخبرة' : 'Years Experience', icon: 'lucide:award' },
  { count: services.length, suffix: '', label: isAr ? 'خدمات التصنيع' : 'Fabrication Services', icon: 'lucide:settings' },
  { text: 'M-40', label: isAr ? 'منشأتنا في مصفح' : 'Musaffah Facility', icon: 'lucide:map-pin' },
  { text: isAr ? 'الإمارات' : 'UAE', label: isAr ? 'مصنع مرخّص' : 'Licensed Manufacturer', icon: 'lucide:shield-check' },
];

const process = isAr
  ? [
      { step: 1, title: 'إرسال الاستفسار', desc: 'شاركنا رسومات مشروعك ومواصفاته والكميات المطلوبة، ونراجعها ونؤكد إمكانية التنفيذ خلال يوم عمل واحد.', icon: 'lucide:file-text' },
      { step: 2, title: 'عرض السعر والموافقة', desc: 'تستلم عرض سعر مفصلاً يتضمن تفصيل الأسعار والجدول الزمني للإنتاج وموعد التسليم لمراجعته.', icon: 'lucide:calculator' },
      { step: 3, title: 'التصنيع', desc: 'يدخل طلبك مرحلة الإنتاج: القص والتشكيل واللحام والتجميع والتشطيب باستخدام معدات CNC وفنيين ذوي خبرة.', icon: 'lucide:wrench' },
      { step: 4, title: 'فحص الجودة والتسليم', desc: 'فحص الجودة والتغليف الواقي والتسليم في الموعد إلى موقع مشروعك في أبوظبي أو أي مكان في الإمارات.', icon: 'lucide:truck' },
    ]
  : [
      { step: 1, title: 'Submit Inquiry', desc: 'Share your project drawings, specifications, and quantities. We review and confirm feasibility within one business day.', icon: 'lucide:file-text' },
      { step: 2, title: 'Quotation & Approval', desc: 'Receive a detailed quotation with pricing breakdown, production timeline, and delivery schedule for your review.', icon: 'lucide:calculator' },
      { step: 3, title: 'Fabrication', desc: 'Your order enters production. Cutting, forming, welding, assembly, and finishing using CNC equipment and skilled fabricators.', icon: 'lucide:wrench' },
      { step: 4, title: 'QC & Delivery', desc: 'Quality inspection, protective packing, and on-time delivery to your project site across Abu Dhabi or the UAE.', icon: 'lucide:truck' },
    ];

const t = isAr
  ? {
      heroBadge: `مصفح، أبوظبي — منذ ${est}`,
      heroAlt: 'منشأة دكت ماسترز للتصنيع في مصفح، أبوظبي',
      h1a: 'تصنيع مجاري التكييف',
      h1b: 'وتشكيل الصفائح المعدنية في أبوظبي',
      heroText: `${biz.tagline}. مجاري هواء حسب الطلب وأعمال معدنية دقيقة للمشاريع التجارية والصناعية ومشاريع البنية التحتية — بخبرة تزيد على ${years} عاماً في الإمارات.`,
      call: 'اتصل',
      quote: 'اطلب عرض سعر',
      scroll: 'مرّر للأسفل',
      capBadge: 'قدراتنا',
      capTitle: 'خدمات تصنيع متكاملة',
      capText: 'من تصنيع مجاري التكييف إلى القص بالليزر عالي الدقة والتصنيع الصناعي حسب الطلب — كل ما يحتاجه مشروعك من منشأة واحدة في مصفح.',
      learnMore: 'اعرف المزيد',
      teamAlt: 'فريق التصنيع في دكت ماسترز أثناء العمل',
      yearsUae: 'عاماً في الإمارات',
      aboutBadge: 'عن دكت ماسترز',
      aboutTitle: 'مصنع مجاري التكييف الموثوق في أبوظبي',
      aboutP1: `دكت ماسترز شركة متخصصة في تصنيع مجاري التكييف وتشكيل الصفائح المعدنية، مقرها M-40 في مصفح بأبوظبي. منذ عام ${est} نورّد منتجات مجاري هواء التكييف وحلول الأعمال المعدنية حسب الطلب للمشاريع التجارية والصناعية والإنشائية ومشاريع البنية التحتية في جميع أنحاء الإمارات.`,
      aboutP2: 'بتركيزنا على جودة التصنيع ودقة الإنتاج والدعم الموثوق للمشاريع، نخدم المقاولين وشركات التكييف وشركات الإنشاءات ومشغّلي المنشآت والعملاء الصناعيين.',
      aboutCta: 'تعرّف علينا أكثر',
      procBadge: 'منهجية العمل',
      procTitle: 'كيف ننجز مشروعك',
      procText: 'من الاستفسار حتى التسليم — يمرّ كل مشروع بمراحل منظمة تضمن الجودة والدقة والتسليم في الموعد المحدد.',
      galBadge: 'ورشتنا',
      galTitle: 'من داخل منشأتنا',
      galText: 'تعرّف على ورشة التصنيع لدينا في مصفح — المجهزة بماكينات قص بالليزر CNC وماكينات ثني الصفائح ومحطات لحام وأدوات تصنيع احترافية.',
      areaBadge: 'مناطق الخدمة',
      areaTitle: 'المناطق الصناعية التي نخدمها',
      areaText: `نصنّع ونسلّم في ${biz.serviceRadius}، انطلاقاً من منشأتنا ذات الموقع المركزي في مصفح.`,
      ctaAlt: 'ورشة التصنيع في دكت ماسترز',
      ctaTitle: 'هل أنت مستعد لبدء مشروعك؟',
      ctaText: 'أرسل لنا رسوماتك ومواصفاتك، ونقدّم لك عروض أسعار تنافسية لتصنيع مجاري التكييف وتشكيل الصفائح المعدنية والأعمال المعدنية حسب الطلب في أبوظبي وجميع أنحاء الإمارات.',
      visit: 'زورونا في مصفح',
    }
  : {
      heroBadge: `Musaffah, Abu Dhabi — Since ${est}`,
      heroAlt: 'Duct Masters manufacturing facility in Musaffah, Abu Dhabi',
      h1a: 'HVAC Duct Manufacturing',
      h1b: '& Sheet Metal Fabrication in Abu Dhabi',
      heroText: `${biz.tagline}. Custom ductwork and precision metal fabrication for commercial, industrial, and infrastructure projects — backed by ${years}+ years in the UAE.`,
      call: 'Call',
      quote: 'Request a Quote',
      scroll: 'Scroll',
      capBadge: 'Our Capabilities',
      capTitle: 'Complete Fabrication Services',
      capText: 'From HVAC duct manufacturing to precision laser cutting and custom industrial fabrication — everything you need from a single facility in Musaffah.',
      learnMore: 'Learn more',
      teamAlt: 'Duct Masters fabrication team at work',
      yearsUae: 'Years in UAE',
      aboutBadge: 'About Duct Masters',
      aboutTitle: "Abu Dhabi's Trusted HVAC Duct Manufacturer",
      aboutP1: `Duct Masters is an Abu Dhabi-based HVAC duct manufacturing and sheet metal fabrication company operating from M-40, Musaffah. Since ${est}, we have supplied air conditioning ducting products and custom metal fabrication solutions for commercial, industrial, construction, and infrastructure projects across the UAE.`,
      aboutP2: 'With a focus on quality manufacturing, accurate production, and reliable project support, we serve contractors, HVAC companies, construction firms, facility operators, and industrial clients.',
      aboutCta: 'Learn More About Us',
      procBadge: 'Our Process',
      procTitle: 'How We Deliver Your Project',
      procText: 'From inquiry to delivery — every project follows a structured process ensuring quality, accuracy, and on-time completion.',
      galBadge: 'Our Workshop',
      galTitle: 'Inside Our Facility',
      galText: 'See our manufacturing workshop in Musaffah — equipped with CNC laser cutters, press brakes, welding stations, and professional fabrication tools.',
      areaBadge: 'Service Areas',
      areaTitle: 'Industrial Zones We Serve',
      areaText: `Manufacturing and delivering across ${biz.serviceRadius} with our facility centrally located in Musaffah.`,
      ctaAlt: 'Duct Masters fabrication workshop',
      ctaTitle: 'Ready to Start Your Project?',
      ctaText: 'Send us your drawings and specifications. We provide competitive quotations for HVAC duct manufacturing, sheet metal fabrication, and custom metal works across Abu Dhabi and the UAE.',
      visit: 'Visit Us in Musaffah',
    };

const pageTitle = isAr
  ? 'تصنيع مجاري التكييف في أبوظبي | دكت ماسترز'
  : `HVAC Duct Manufacturing Abu Dhabi | ${business.name}`;
const pageDescription = isAr
  ? `تصنيع مجاري التكييف وتشكيل الصفائح المعدنية في M-40 مصفح، أبوظبي منذ ${est}. مجاري هواء حسب الطلب لمشاريع الإمارات. اتصل ${business.phone}.`
  : `HVAC duct and sheet metal fabrication in M-40 Musaffah, Abu Dhabi since ${est}. Custom ductwork for UAE projects. Call ${business.phone}.`;

const pageUrl = new URL(localizePath('/', lang), business.website).href;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': WEBSITE_ID, url: `${business.website}/`, name: business.name, description: business.description, publisher: businessRef() },
    {
      ...businessEntity(),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: isAr ? 'خدمات التصنيع' : 'Fabrication Services',
        itemListElement: services.map((s) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', '@id': `${business.website}${serviceUrl(s.slug, lang)}#service`, name: s.name, url: `${business.website}${serviceUrl(s.slug, lang)}` },
        })),
      },
    },
    isAr
      ? { '@type': 'WebPage', '@id': `${pageUrl}#webpage`, url: pageUrl, name: pageTitle, inLanguage: htmlLang[lang], isPartOf: { '@id': WEBSITE_ID }, about: businessRef(), description: pageDescription }
      : { '@type': 'WebPage', '@id': `${business.website}/#webpage`, url: `${business.website}/`, name: pageTitle, isPartOf: { '@id': WEBSITE_ID }, about: businessRef(), description: pageDescription },
  ],
};

const arrowNudge = 'group-hover:translate-x-1.5 rtl:group-hover:-translate-x-1.5';
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>

  <!-- HERO -->
  <section class="relative -mt-28 flex min-h-[100vh] items-center overflow-hidden bg-brand-950 lg:-mt-[140px]">
    <div class="absolute inset-0">
      <img src="/images/gallery/factory-workshop.webp" alt={t.heroAlt} class="h-full w-full scale-105 object-cover" width="1200" height="670" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-r rtl:bg-gradient-to-l from-brand-950 via-brand-950/85 to-brand-950/40"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-brand-950 via-transparent to-brand-950/60"></div>
      <div class="blueprint-grid animate-grid-pan absolute inset-0 opacity-60"></div>
      <div class="absolute -top-24 end-0 h-[36rem] w-[36rem] rounded-full bg-accent-500/20 blur-[120px] animate-glow"></div>
      <div class="absolute bottom-0 start-1/4 h-80 w-80 rounded-full bg-brand-500/20 blur-[100px] animate-float-slow"></div>
    </div>

    <div class="relative mx-auto w-full max-w-7xl px-5 pt-28 pb-24 lg:px-8 lg:pt-40 lg:pb-32">
      <div class="max-w-3xl">
        <span data-reveal class="inline-flex items-center gap-2 rounded-full border border-accent-400/30 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-accent-400 backdrop-blur-sm">
          <span class="relative flex size-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-400 opacity-70"></span>
            <span class="relative inline-flex size-2 rounded-full bg-accent-400"></span>
          </span>
          <span>{t.heroBadge}</span>
        </span>
        <h1 data-reveal style="--reveal-delay: 80ms" class="mt-6 font-display text-4xl font-bold leading-[1.1] tracking-tight text-white sm:text-5xl lg:text-6xl">
          <span>{t.h1a}</span><br />
          <span class="text-gradient">{t.h1b}</span>
        </h1>
        <p data-reveal style="--reveal-delay: 160ms" class="mt-7 max-w-xl text-lg leading-relaxed text-brand-200">{t.heroText}</p>
        <div data-reveal style="--reveal-delay: 240ms" class="mt-9 flex flex-wrap gap-4">
          <a href={business.phoneHref} class="btn-shine group inline-flex items-center gap-2 rounded-xl bg-gradient-to-br from-accent-500 to-brand-500 px-7 py-4 text-sm font-semibold text-white shadow-lg shadow-accent-600/30 transition-all hover:shadow-xl hover:shadow-accent-600/50 hover:-translate-y-0.5">
            <Icon name="lucide:phone" class="size-5 transition-transform group-hover:rotate-12" />
            <span>{t.call} <span dir="ltr">{business.phone}</span></span>
          </a>
          <a href={contactUrl(lang)} class="inline-flex items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-7 py-4 text-sm font-semibold text-white backdrop-blur-sm transition-all hover:border-white/30 hover:bg-white/10">
            <Icon name="lucide:file-text" class="size-5" />
            <span>{t.quote}</span>
          </a>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 flex -translate-x-1/2 animate-bounce flex-col items-center gap-2 text-white/40">
      <span class="text-[10px] uppercase tracking-[0.2em]">{t.scroll}</span>
      <Icon name="lucide:chevron-down" class="size-4" />
    </div>
  </section>

  <!-- STATS -->
  <section class="relative bg-brand-950">
    <div class="mx-auto grid max-w-7xl grid-cols-2 sm:grid-cols-4">
      {stats.map((stat, i) => (
        <div data-reveal style={`--reveal-delay: ${i * 90}ms`} class="group relative flex flex-col items-center justify-center border-b border-white/5 px-4 py-10 text-center transition-colors hover:bg-white/[0.03] sm:border-b-0 [&:not(:last-child)]:sm:border-e [&:not(:last-child)]:sm:border-white/5">
          <div class="flex size-12 items-center justify-center rounded-2xl bg-gradient-to-br from-accent-500/20 to-brand-500/10 ring-1 ring-white/10 transition-transform group-hover:scale-110 group-hover:ring-accent-400/40">
            <Icon name={stat.icon} class="size-6 text-accent-400" />
          </div>
          <span class="mt-4 font-display text-4xl font-bold text-white sm:text-5xl" dir={isAr && stat.count !== undefined ? 'ltr' : undefined}>
            {stat.count !== undefined ? (<><span data-count={stat.count}>{stat.count}</span>{stat.suffix}</>) : stat.text}
          </span>
          <span class="mt-1.5 text-xs font-medium uppercase tracking-wider text-brand-300">{stat.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- SERVICES -->
  <section class="relative overflow-hidden bg-stone-50 py-24 lg:py-32">
    <div class="dot-grid absolute inset-0 opacity-40"></div>
    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <span data-reveal class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-700 shadow-sm">
          <Icon name="lucide:wrench" class="size-3.5" />
          <span>{t.capBadge}</span>
        </span>
        <h2 data-reveal style="--reveal-delay: 80ms" class="mt-5 font-display text-4xl font-bold tracking-tight text-brand-900 sm:text-5xl">{t.capTitle}</h2>
        <p data-reveal style="--reveal-delay: 140ms" class="mx-auto mt-5 text-lg text-stone-600">{t.capText}</p>
      </div>
      <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service, i) => (
          <a href={serviceUrl(service.slug, lang)} data-reveal style={`--reveal-delay: ${(i % 3) * 90}ms`} class="gradient-border group relative flex flex-col overflow-hidden rounded-3xl border border-stone-200/80 bg-white shadow-sm transition-all duration-500 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-brand-900/10">
            <div class="relative h-52 overflow-hidden">
              <img src={galleryImages[i % galleryImages.length].src} alt={service.name} class="h-full w-full object-cover transition-transform duration-[900ms] group-hover:scale-110" width="1200" height="670" loading={i < 6 ? 'eager' : 'lazy'} />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-950/90 via-brand-950/25 to-transparent"></div>
              <span class="absolute top-4 end-5 font-display text-5xl font-bold text-white/15">{String(i + 1).padStart(2, '0')}</span>
              <div class="absolute top-4 start-4 flex size-11 items-center justify-center rounded-xl bg-white/10 ring-1 ring-white/20 backdrop-blur-md transition-colors group-hover:bg-accent-500">
                <Icon name={service.icon} class="size-5 text-white" />
              </div>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="font-display text-xl font-semibold text-brand-900 transition-colors group-hover:text-brand-600">{service.name}</h3>
              <p class="mt-2.5 line-clamp-2 text-sm leading-relaxed text-stone-600">{service.description}</p>
              <div class="mt-5 flex items-center gap-1.5 text-sm font-semibold text-brand-600">
                <span>{t.learnMore}</span>
                <Icon name="lucide:arrow-right" class={`size-4 transition-transform rtl:rotate-180 ${arrowNudge}`} />
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="gradient-animated relative overflow-hidden py-24 lg:py-32">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="animate-aurora-a absolute -start-24 -top-20 h-[28rem] w-[28rem] rounded-full bg-accent-400/45 blur-[90px]"></div>
      <div class="animate-aurora-b absolute end-0 top-1/4 h-[26rem] w-[26rem] rounded-full bg-brand-300/35 blur-[110px]"></div>
      <div class="animate-aurora-c absolute -bottom-24 start-1/3 h-[26rem] w-[26rem] rounded-full bg-accent-500/35 blur-[100px]"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
        <div data-reveal={isAr ? 'right' : 'left'} class="relative">
          <div class="absolute -start-6 -top-6 h-28 w-28 rounded-2xl border border-brand-200 dot-grid opacity-70"></div>
          <div class="relative overflow-hidden rounded-3xl shadow-2xl shadow-brand-900/20 ring-1 ring-stone-900/5">
            <img src="/images/gallery/workers-collaborating-metal-fabrication.webp" alt={t.teamAlt} class="w-full object-cover" width="1200" height="670" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-950/30 to-transparent"></div>
          </div>
          <div class="absolute -bottom-6 -end-6 hidden rounded-2xl bg-gradient-to-br from-brand-800 to-brand-950 p-6 shadow-xl ring-1 ring-white/10 lg:block">
            <span class="font-display text-4xl font-bold text-white" dir={isAr ? 'ltr' : undefined}><span data-count={years}>{years}</span>+</span>
            <p class="mt-1 text-xs text-brand-300">{t.yearsUae}</p>
          </div>
        </div>
        <div data-reveal={isAr ? 'left' : 'right'}>
          <span class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-700">
            <Icon name="lucide:building-2" class="size-3.5" />
            <span>{t.aboutBadge}</span>
          </span>
          <h2 class="mt-5 font-display text-4xl font-bold tracking-tight text-brand-900 sm:text-[2.75rem] sm:leading-tight">{t.aboutTitle}</h2>
          <p class="mt-6 text-lg leading-relaxed text-stone-600">{t.aboutP1}</p>
          <p class="mt-4 leading-relaxed text-stone-600">{t.aboutP2}</p>
          <div class="mt-9 flex flex-wrap gap-4">
            <a href={aboutUrl(lang)} class="btn-shine inline-flex items-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand-600/20 transition-all hover:-translate-y-0.5 hover:bg-brand-700">
              <span>{t.aboutCta}</span> <Icon name="lucide:arrow-right" class="size-4 rtl:rotate-180" />
            </a>
            <a href={business.phoneHref} class="inline-flex items-center gap-2 rounded-xl border border-stone-300 px-6 py-3.5 text-sm font-semibold text-stone-700 transition-all hover:border-brand-300 hover:bg-stone-50">
              <Icon name="lucide:phone" class="size-4" /> <span dir="ltr">{business.phone}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="relative overflow-hidden bg-brand-950 py-24 lg:py-32">
    <div class="blueprint-grid-dark absolute inset-0"></div>
    <div class="absolute -top-32 left-1/2 h-96 w-[40rem] -translate-x-1/2 rounded-full bg-brand-500/15 blur-[130px]"></div>
    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <span data-reveal class="inline-flex items-center gap-2 rounded-full border border-accent-400/20 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-accent-400">
          <Icon name="lucide:list-checks" class="size-3.5" />
          <span>{t.procBadge}</span>
        </span>
        <h2 data-reveal style="--reveal-delay: 80ms" class="mt-5 font-display text-4xl font-bold tracking-tight text-white sm:text-5xl">{t.procTitle}</h2>
        <p data-reveal style="--reveal-delay: 140ms" class="mx-auto mt-5 text-lg text-brand-300">{t.procText}</p>
      </div>
      <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {process.map((item, i) => (
          <div data-reveal style={`--reveal-delay: ${i * 100}ms`} class="group relative rounded-3xl border border-white/10 bg-white/[0.03] p-7 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-accent-400/30 hover:bg-white/[0.06]">
            <div class="flex items-center justify-between">
              <div class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-accent-500 to-brand-500 font-display text-xl font-bold text-white shadow-lg shadow-accent-600/30 transition-transform group-hover:scale-110">{item.step}</div>
              <Icon name={item.icon} class="size-6 text-accent-400/70 transition-colors group-hover:text-accent-400" />
            </div>
            <h3 class="mt-6 font-display text-lg font-semibold text-white">{item.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-brand-300">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="overflow-hidden bg-stone-50 py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <span data-reveal class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-700 shadow-sm">
          <Icon name="lucide:camera" class="size-3.5" />
          <span>{t.galBadge}</span>
        </span>
        <h2 data-reveal style="--reveal-delay: 80ms" class="mt-5 font-display text-4xl font-bold tracking-tight text-brand-900 sm:text-5xl">{t.galTitle}</h2>
        <p data-reveal style="--reveal-delay: 140ms" class="mx-auto mt-5 text-lg text-stone-600">{t.galText}</p>
      </div>
    </div>
    <div data-reveal class="marquee-mask mt-14 overflow-hidden" dir="ltr">
      <div class="animate-marquee flex w-max gap-5 pb-2 hover:[animation-play-state:paused]" style="animation-duration: 55s">
        {[...galleryImages, ...galleryImages].map((img) => (
          <div class="group relative w-72 shrink-0 overflow-hidden rounded-3xl shadow-lg ring-1 ring-stone-900/5 sm:w-80 lg:w-96">
            <img src={img.src} alt={img.alt} class="h-56 w-full object-cover transition-transform duration-700 group-hover:scale-110 sm:h-64 lg:h-72" width="1200" height="670" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-950/70 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
              <div class="absolute bottom-0 left-0 right-0 p-5"><p class="text-xs leading-relaxed text-white/90" dir={isAr ? 'rtl' : undefined}>{img.alt}</p></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AREAS -->
  <section class="relative overflow-hidden bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <span data-reveal class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-700">
          <Icon name="lucide:map-pin" class="size-3.5" />
          <span>{t.areaBadge}</span>
        </span>
        <h2 data-reveal style="--reveal-delay: 80ms" class="mt-5 font-display text-4xl font-bold tracking-tight text-brand-900 sm:text-5xl">{t.areaTitle}</h2>
        <p data-reveal style="--reveal-delay: 140ms" class="mx-auto mt-5 text-lg text-stone-600">{t.areaText}</p>
      </div>
      <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {areas.map((area, i) => (
          <a href={areaUrl(area.slug, lang)} data-reveal style={`--reveal-delay: ${(i % 4) * 80}ms`} class="group relative flex items-center gap-4 overflow-hidden rounded-2xl border border-stone-200 bg-stone-50 p-5 transition-all duration-300 hover:-translate-y-1 hover:border-brand-300 hover:bg-white hover:shadow-lg hover:shadow-brand-900/5">
            <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 ring-1 ring-brand-100 transition-colors group-hover:bg-brand-500 group-hover:ring-brand-500"><Icon name="lucide:map-pin" class="size-5 text-brand-600 transition-colors group-hover:text-white" /></div>
            <div><h3 class="font-semibold text-stone-800 transition-colors group-hover:text-brand-800">{area.name}</h3><p class="text-xs text-stone-500">{area.county}</p></div>
            <Icon name="lucide:arrow-up-right" class="ms-auto size-4 text-stone-300 transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-brand-500 rtl:-scale-x-100 rtl:group-hover:-translate-x-0.5" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden bg-brand-950">
    <div class="absolute inset-0"><img src="/images/gallery/workers-fabricating-sheet-metal.webp" alt={t.ctaAlt} class="h-full w-full object-cover opacity-20" width="1200" height="670" loading="lazy" /></div>
    <div class="absolute inset-0 bg-gradient-to-t from-brand-950 via-brand-950/85 to-brand-950/70"></div>
    <div class="blueprint-grid-dark absolute inset-0 opacity-70"></div>
    <div class="absolute -bottom-24 left-1/2 h-80 w-[42rem] -translate-x-1/2 rounded-full bg-accent-500/15 blur-[120px]"></div>
    <div class="relative mx-auto max-w-4xl px-5 py-24 text-center lg:px-8 lg:py-32">
      <h2 data-reveal class="font-display text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">{t.ctaTitle}</h2>
      <p data-reveal style="--reveal-delay: 80ms" class="mx-auto mt-6 max-w-xl text-lg text-brand-200">{t.ctaText}</p>
      <div data-reveal style="--reveal-delay: 160ms" class="mt-11 flex flex-wrap items-center justify-center gap-4">
        <a href={business.phoneHref} class="btn-shine group inline-flex items-center gap-2 rounded-xl bg-gradient-to-br from-accent-500 to-brand-500 px-8 py-4 text-sm font-semibold text-white shadow-lg shadow-accent-600/30 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-accent-600/50"><Icon name="lucide:phone" class="size-5 transition-transform group-hover:rotate-12" /><span dir="ltr">{business.phone}</span></a>
        <a href={`mailto:${business.email}`} class="inline-flex items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-8 py-4 text-sm font-semibold text-white backdrop-blur-sm transition-all hover:border-white/30 hover:bg-white/10"><Icon name="lucide:mail" class="size-5" /><span dir="ltr">{business.email}</span></a>
        <a href={business.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-8 py-4 text-sm font-semibold text-white backdrop-blur-sm transition-all hover:border-white/30 hover:bg-white/10"><Icon name="lucide:map-pin" class="size-5" /><span>{t.visit}</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
