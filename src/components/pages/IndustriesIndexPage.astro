---
// Industries index (/industries/ and /ar/industries/)
import BaseLayout from '../../layouts/BaseLayout.astro';
import { business } from '../../data/business';
import { contactUrl } from '../../lib/urls';
import { Icon } from 'astro-icon/components';
import { getLang, htmlLang, localizePath } from '../../i18n';
import { getBusiness } from '../../i18n/localize';
import { getIndustries } from '../../i18n/industries';

const lang = getLang(Astro.url);
const b = getBusiness(lang);
const industryList = getIndustries(lang);

const copy = {
  en: {
    title: `Industries Served | ${b.name}`,
    description: 'Ductwork and metal fabrication for HVAC and MEP contractors, construction, industrial, commercial and infrastructure projects across the UAE.',
    schemaName: 'Industries Served',
    schemaDescription: `${b.name} serves HVAC contractors, MEP contractors, construction companies, industrial facilities, commercial buildings, and infrastructure projects across Abu Dhabi and the UAE.`,
    crumb: 'Industries',
    h1: 'Industries We Serve',
    intro: `${b.name} provides HVAC duct manufacturing, sheet metal fabrication, and custom metal works to a wide range of industries across Abu Dhabi and the UAE.`,
    learnMore: 'Learn more',
    ctaHeading: 'Not Sure If We Serve Your Industry?',
    ctaText: 'Contact us to discuss your project. We likely have experience in your sector.',
    contact: 'Contact Us',
  },
  ar: {
    title: `القطاعات التي نخدمها | ${b.name}`,
    description: 'تصنيع مجاري التكييف والأعمال المعدنية لمقاولي التكييف وMEP والإنشاءات والمنشآت الصناعية والمباني التجارية ومشاريع البنية التحتية في الإمارات.',
    schemaName: 'القطاعات التي نخدمها',
    schemaDescription: `تخدم ${b.name} مقاولي التكييف ومقاولي الأعمال الكهروميكانيكية (MEP) وشركات الإنشاءات والمنشآت الصناعية والمباني التجارية ومشاريع البنية التحتية في أبوظبي وجميع أنحاء الإمارات.`,
    crumb: 'القطاعات',
    h1: 'القطاعات التي نخدمها',
    intro: `تقدّم ${b.name} خدمات تصنيع مجاري التكييف وتشكيل الصفائح المعدنية والأعمال المعدنية حسب الطلب لمجموعة واسعة من القطاعات في أبوظبي وجميع أنحاء الإمارات.`,
    learnMore: 'اعرف المزيد',
    ctaHeading: 'لست متأكداً إن كنا نخدم قطاعك؟',
    ctaText: 'تواصل معنا لمناقشة مشروعك، فعلى الأرجح لدينا خبرة في قطاعك.',
    contact: 'تواصل معنا',
  },
}[lang];

const industryHref = (slug: string) => localizePath(`/industries/${slug}/`, lang);

// Bento grid: asymmetric column spans (6-col track) + which tiles render as dark "feature" cards
const bentoLayout = [
  'lg:col-span-4', 'lg:col-span-2',
  'lg:col-span-2', 'lg:col-span-2', 'lg:col-span-2',
  'lg:col-span-2', 'lg:col-span-4',
  'lg:col-span-6',
];
const featureIdx = new Set([0, 6, 7]);

const industriesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: copy.schemaName,
  description: copy.schemaDescription,
  itemListElement: industryList.map((ind, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'WebPage',
      name: ind.shortName,
      description: ind.summary,
      url: new URL(industryHref(ind.slug), business.website).href,
      inLanguage: htmlLang[lang],
    },
  })),
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  schema={industriesSchema}
  breadcrumbs={[{ label: copy.crumb }]}
>

  <section class="relative -mt-28 flex min-h-[60vh] items-center overflow-hidden bg-brand-950 pt-32 pb-24 lg:-mt-[140px] lg:min-h-[64vh] lg:pt-40 lg:pb-28">
    <div class="absolute inset-0">
      <img src="/images/gallery/factory-uniforms.webp" alt="" class="h-full w-full object-cover" width="1200" height="670" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-b from-brand-950/92 via-brand-950/82 to-brand-950/96"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_40%,_rgba(46,104,156,0.28),_transparent_70%)]"></div>
      <div class="blueprint-grid-dark absolute inset-0 opacity-30"></div>
    </div>
    <div class="relative mx-auto w-full max-w-3xl px-5 text-center lg:px-8">
      <span data-reveal class="mx-auto inline-flex size-14 items-center justify-center rounded-2xl border border-white/20 bg-white/10 text-white shadow-lg backdrop-blur-sm">
        <Icon name="lucide:building-2" class="size-7" />
      </span>
      <h1 data-reveal style="--reveal-delay: 80ms" class="mt-6 font-display text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">{copy.h1}</h1>
      <p data-reveal style="--reveal-delay: 160ms" class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-brand-100">
        {copy.intro}
      </p>
    </div>
  </section>

  <section class="bg-gradient-to-b from-stone-50 via-white to-stone-50 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-6">
        {industryList.map((ind, i) => {
          const isFeature = featureIdx.has(i);
          return (
            <a
              href={industryHref(ind.slug)}
              data-reveal
              data-spotlight={!isFeature}
              style={`--reveal-delay: ${(i % 3) * 80}ms`}
              class={`group relative flex flex-col justify-between overflow-hidden rounded-3xl p-7 transition-all duration-500 hover:-translate-y-1.5 ${bentoLayout[i]} ${isFeature ? 'bg-gradient-to-br from-brand-800 to-brand-950 text-white ring-1 ring-white/10 hover:shadow-2xl hover:shadow-brand-900/30' : 'spotlight-card gradient-border border border-stone-200 bg-white shadow-sm hover:shadow-2xl hover:shadow-brand-900/10'}`}
            >
              {isFeature && <div class="blueprint-grid-dark absolute inset-0 opacity-40"></div>}
              {isFeature && <div class="absolute -end-16 -top-16 h-52 w-52 rounded-full bg-accent-500/20 blur-[80px]"></div>}
              <div class="relative max-w-xl">
                <div class={`flex items-center justify-center rounded-2xl transition-all duration-300 group-hover:-rotate-6 group-hover:scale-110 ${isFeature ? 'size-14 bg-white/10 ring-1 ring-white/15' : 'size-12 bg-gradient-to-br from-accent-500/15 to-brand-500/10 ring-1 ring-brand-100 group-hover:from-accent-500 group-hover:to-brand-500'}`}>
                  <Icon name={ind.icon} class={isFeature ? 'size-7 text-accent-400' : 'size-6 text-brand-700 transition-colors group-hover:text-white'} />
                </div>
                <h2 class={`font-display font-bold tracking-tight ${isFeature ? 'mt-5 text-2xl text-white' : 'mt-4 text-lg text-brand-900'}`}>{ind.shortName}</h2>
                <p class={isFeature ? 'mt-3 leading-relaxed text-brand-200' : 'mt-2 text-sm leading-relaxed text-stone-600'}>{ind.summary}</p>
              </div>
              <div class={`relative mt-6 flex items-center gap-1.5 text-sm font-semibold ${isFeature ? 'text-accent-400' : 'text-brand-600'}`}>
                <span>{copy.learnMore}</span>
                <Icon name="lucide:arrow-right" class="size-4 transition-transform rtl:rotate-180 group-hover:translate-x-1.5 rtl:group-hover:-translate-x-1.5" />
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-brand-950 py-16 lg:py-20">
    <div class="absolute inset-0 bg-gradient-to-t from-brand-950 via-brand-950/90 to-brand-900"></div>
    <div class="blueprint-grid-dark absolute inset-0 opacity-70"></div>
    <div class="absolute -bottom-24 left-1/2 h-80 w-[42rem] -translate-x-1/2 rounded-full bg-accent-500/15 blur-[120px]"></div>
    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="flex flex-col items-center gap-6 text-center sm:flex-row sm:justify-between sm:text-start">
        <div>
          <h2 class="font-display text-3xl font-bold tracking-tight text-white">{copy.ctaHeading}</h2>
          <p class="mt-2 text-brand-200">{copy.ctaText}</p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-4">
          <a href={business.phoneHref} class="btn-shine group inline-flex items-center gap-2 rounded-xl bg-gradient-to-br from-accent-500 to-brand-500 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-accent-600/30 transition-all hover:-translate-y-0.5">
            <Icon name="lucide:phone" class="size-5" /><span dir="ltr">{business.phone}</span>
          </a>
          <a href={contactUrl(lang)} class="inline-flex items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-6 py-3.5 text-sm font-semibold text-white backdrop-blur-sm transition-all hover:border-white/30 hover:bg-white/10">
            {copy.contact}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
