---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { business } from '../../data/business';
import { serviceUrl, contactUrl } from '../../lib/urls';
import { getLang, localizePath } from '../../i18n';
import { getServices } from '../../i18n/localize';

const lang = getLang(Astro.url);
const isAr = lang === 'ar';
const services = getServices(lang);

const t = isAr
  ? {
      title: 'الصفحة غير موجودة',
      description: 'تعذّر العثور على الصفحة المطلوبة. تصفّح خدمات التصنيع لدى دكت ماسترز أو تواصل مع منشأتنا في مصفح.',
      eyebrow: 'خطأ 404',
      h1: 'الصفحة غير موجودة',
      text: 'الصفحة التي طلبتها غير موجودة أو تم نقلها. جرّب إحدى خدماتنا أدناه، أو اتصل بنا على',
      home: 'العودة إلى الرئيسية',
      quote: 'اطلب عرض سعر',
    }
  : {
      title: 'Page Not Found',
      description: 'The page you are looking for could not be found. Browse Duct Masters fabrication services or contact our Musaffah facility.',
      eyebrow: 'Error 404',
      h1: 'Page Not Found',
      text: 'The page you requested does not exist or has moved. Try one of our services below, or call us on',
      home: 'Return Home',
      quote: 'Request a Quote',
    };
---

<BaseLayout
  title={t.title}
  description={t.description}
  noindex
>
  <section class="mx-auto max-w-3xl px-5 py-24 text-center lg:py-32">
    <p class="text-sm font-semibold uppercase tracking-wider text-accent-600">{t.eyebrow}</p>
    <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-brand-900 sm:text-5xl">{t.h1}</h1>
    <p class="mx-auto mt-5 max-w-xl text-stone-600">
      {t.text} <span dir="ltr">{business.phone}</span>.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href={localizePath('/', lang)} class="btn-shine inline-flex items-center gap-2 rounded-xl bg-gradient-to-br from-accent-500 to-brand-500 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-accent-600/30">
        <Icon name="lucide:home" class="size-4" />{t.home}
      </a>
      <a href={contactUrl(lang)} class="inline-flex items-center gap-2 rounded-xl border border-stone-300 px-6 py-3.5 text-sm font-semibold text-stone-700 hover:border-brand-300 hover:text-brand-700">
        <Icon name="lucide:file-text" class="size-4" />{t.quote}
      </a>
    </div>
    <ul class="mt-12 flex flex-wrap justify-center gap-3">
      {services.map((service) => (
        <li>
          <a href={serviceUrl(service.slug, lang)} class="inline-flex rounded-full border border-stone-200 bg-white px-4 py-2 text-sm text-stone-600 hover:border-brand-300 hover:text-brand-700">{service.name}</a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
