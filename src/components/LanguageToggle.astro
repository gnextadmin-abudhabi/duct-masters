---
// Switches to the same page in the other language (/contact/ ⇄ /ar/contact/).
// A plain link so search engines can follow it; the choice is remembered
// for the landing pages, but visitors are never redirected automatically.
import { Icon } from 'astro-icon/components';
import { getLang, alternatePath, htmlLang, useTranslations } from '../i18n';

interface Props {
  variant?: 'header' | 'drawer';
}

const { variant = 'header' } = Astro.props;
const lang = getLang(Astro.url);
const target = lang === 'ar' ? 'en' : 'ar';
const t = useTranslations(lang);
const href = alternatePath(Astro.url);

const classes = {
  header:
    'inline-flex h-9 items-center gap-1.5 rounded-lg border border-white/15 bg-white/5 px-3 text-sm font-semibold text-stone-100 transition-all hover:border-accent-400/50 hover:bg-white/10 hover:text-white',
  drawer:
    'flex w-full items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10',
};
---

<a
  href={href}
  hreflang={htmlLang[target]}
  lang={htmlLang[target]}
  data-set-lang={target}
  title={t.switchToLabel}
  aria-label={t.switchToLabel}
  class={classes[variant]}
>
  <Icon name="lucide:languages" class="size-4 text-accent-400" />
  <span>{t.switchTo}</span>
</a>

<script>
  // Bundled once per page even though the toggle renders twice (header + drawer)
  document.querySelectorAll<HTMLAnchorElement>('[data-set-lang]').forEach((a) => {
    a.addEventListener('click', () => {
      try { localStorage.setItem('ductmasters-lang', a.dataset.setLang ?? ''); } catch { /* storage blocked */ }
    });
  });
</script>
