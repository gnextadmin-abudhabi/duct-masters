---
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
import LanguageToggle from './LanguageToggle.astro';
import { getLang, localizePath, useTranslations } from '../i18n';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const path = (p: string) => localizePath(p, lang);

const navLinks = [
  { href: path('/services/'), label: t.nav.services, icon: 'lucide:wrench' },
  { href: path('/areas/'), label: t.nav.areas, icon: 'lucide:map-pin' },
  { href: path('/industries/'), label: t.nav.industries, icon: 'lucide:building-2' },
  { href: path('/about/'), label: t.nav.about, icon: 'lucide:info' },
  { href: path('/contact/'), label: t.nav.contact, icon: 'lucide:mail' },
];
---

<header class="fixed top-0 z-50 w-full transition-all duration-500" id="site-header">
  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <div
      class="mt-0 flex h-28 items-center justify-between rounded-none border-b border-white/10 bg-brand-950/70 px-2 backdrop-blur-xl transition-all duration-500 lg:mt-3 lg:h-32 lg:rounded-2xl lg:border lg:border-white/10 lg:px-3 lg:shadow-lg lg:shadow-brand-950/20"
      id="header-shell"
    >
      <a href={path('/')} class="group flex shrink-0 items-center gap-2.5 ps-1">
        <img src="/images/logo-header.png" alt={t.logoAlt} class="h-28 w-auto transition-transform duration-300 group-hover:scale-105" width="360" height="233" fetchpriority="high" />
      </a>

      <nav class="hidden items-center gap-0.5 lg:flex">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="group relative rounded-lg px-3.5 py-2 text-sm font-medium text-stone-200 transition-colors hover:text-white"
          >
            {link.label}
            <span class="absolute inset-x-3.5 -bottom-0.5 h-px origin-left scale-x-0 rtl:origin-right bg-gradient-to-r from-accent-400 to-brand-400 transition-transform duration-300 group-hover:scale-x-100"></span>
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-1.5 pe-1">
        <div class="hidden sm:block"><LanguageToggle /></div>
        <a href={business.whatsapp} target="_blank" rel="noopener noreferrer" class="hidden size-9 items-center justify-center rounded-lg bg-white/5 text-green-400 transition-all hover:bg-green-500/20 hover:text-green-300 sm:inline-flex" title={t.header.whatsapp} aria-label={t.header.whatsapp}>
          <Icon name="lucide:message-circle" class="size-4" />
        </a>
        <a href={path('/contact/')} class="hidden size-9 items-center justify-center rounded-lg bg-white/5 text-stone-300 transition-all hover:bg-white/10 hover:text-white sm:inline-flex" title={t.header.contactTitle} aria-label={t.header.contactLabel}>
          <Icon name="lucide:mail" class="size-4" />
        </a>
        <a href={business.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="hidden size-9 items-center justify-center rounded-lg bg-white/5 text-stone-300 transition-all hover:bg-white/10 hover:text-white sm:inline-flex" title={t.header.location} aria-label={t.header.locationLabel}>
          <Icon name="lucide:map-pin" class="size-4" />
        </a>
        <a href={business.phoneHref} aria-label={t.header.callLabel(business.phone)} class="btn-shine ms-1 inline-flex items-center gap-2 rounded-lg bg-gradient-to-br from-accent-500 to-brand-500 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-accent-600/25 transition-all hover:shadow-accent-600/40 hover:brightness-110">
          <Icon name="lucide:phone" class="size-4" />
          <span class="hidden sm:inline">{t.header.call}</span>
        </a>
        <button type="button" class="inline-flex size-10 items-center justify-center rounded-lg text-stone-200 transition-colors hover:bg-white/10 hover:text-white lg:hidden" aria-label={t.header.toggleMenu} aria-controls="mobile-menu" aria-expanded="false" id="mobile-menu-btn">
          <Icon name="lucide:menu" class="size-5" id="menu-icon-open" />
          <Icon name="lucide:x" class="hidden size-5" id="menu-icon-close" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div class="hidden lg:hidden" id="mobile-menu">
    <div class="mx-4 mt-2 overflow-hidden rounded-2xl border border-white/10 bg-brand-950/95 backdrop-blur-xl">
      <nav class="space-y-1 p-4">
        {navLinks.map((link) => (
          <a href={link.href} class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-medium text-stone-200 transition-colors hover:bg-white/5 hover:text-white">
            <Icon name={link.icon} class="size-4 text-accent-400" />{link.label}
          </a>
        ))}
        <div class="space-y-2 pt-3">
          <LanguageToggle variant="drawer" />
          <a href={business.phoneHref} class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-br from-accent-500 to-brand-500 px-4 py-3 text-sm font-semibold text-white"><Icon name="lucide:phone" class="size-4" />{t.header.call} <span dir="ltr">{business.phone}</span></a>
          <a href={business.whatsapp} target="_blank" rel="noopener noreferrer" class="flex w-full items-center justify-center gap-2 rounded-xl bg-green-700 px-4 py-3 text-sm font-semibold text-white"><Icon name="lucide:message-circle" class="size-4" />{t.header.chatWhatsapp}</a>
        </div>
      </nav>
    </div>
  </div>
</header>
<!-- Spacer to offset the fixed header -->
<div class="h-28 lg:h-[140px]" aria-hidden="true"></div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  btn?.addEventListener('click', () => {
    // toggle() returns true when "hidden" was added, i.e. the menu closed
    const open = !menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(open));
  });

  const shell = document.getElementById('header-shell');
  const onScroll = () => {
    if (window.scrollY > 12) {
      shell?.classList.add('lg:shadow-xl', 'ring-1', 'ring-white/10');
      shell?.classList.remove('bg-brand-950/70');
      shell?.classList.add('bg-brand-950/90');
    } else {
      shell?.classList.remove('lg:shadow-xl', 'ring-1', 'ring-white/10');
      shell?.classList.add('bg-brand-950/70');
      shell?.classList.remove('bg-brand-950/90');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
