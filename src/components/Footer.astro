---
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
import { serviceUrl, areaUrl } from '../lib/urls';
import { getLang, localizePath, useTranslations } from '../i18n';
import { getBusiness, getServices, getAreas } from '../i18n/localize';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const biz = getBusiness(lang);
const path = (p: string) => localizePath(p, lang);
const chevron = 'size-3 text-stone-600 transition-colors group-hover:text-brand-400 rtl:rotate-180';
const companyLinks = [
  { href: '/about/', label: t.footer.aboutUs },
  { href: '/services/', label: t.footer.services },
  { href: '/areas/', label: t.footer.areas },
  { href: '/industries/', label: t.footer.industries },
  { href: '/blog/', label: t.footer.blog },
  { href: '/contact/', label: t.footer.contact },
];
---

<!-- ==================== FOOTER ==================== -->
<footer class="relative overflow-hidden bg-brand-950 text-white">
  <div class="h-px w-full bg-gradient-to-r from-transparent via-accent-500/60 to-transparent"></div>
  <div class="blueprint-grid-dark absolute inset-0 opacity-50"></div>
  <div class="absolute -top-32 end-0 h-80 w-80 rounded-full bg-brand-500/10 blur-[110px]"></div>
  <div class="relative mx-auto max-w-7xl px-5 pb-10 pt-16 lg:px-8 lg:pt-20">
    <!-- Top row: logo + description + map -->
    <div class="border-b border-white/10 pb-10">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-12">
        <div class="max-w-md">
          <a href={path('/')} class="inline-flex items-center gap-2.5">
            <img
              src="/images/logo-footer.png"
              alt={t.logoAlt}
              class="h-24 w-auto lg:h-32"
              width="420" height="272"
              loading="lazy"
            />
          </a>
          <p class="mt-4 text-sm leading-relaxed text-stone-400">
            {t.footer.about(business.tagline, business.yearEstablished)}
          </p>
          <a
            href={business.phoneHref}
            class="group mt-6 inline-flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-5 py-3 backdrop-blur-sm transition-all hover:border-accent-400/40 hover:bg-white/10"
          >
            <div class="flex size-10 items-center justify-center rounded-full bg-gradient-to-br from-accent-500 to-brand-500 transition-transform group-hover:scale-110">
              <Icon name="lucide:phone" class="size-5 text-white" />
            </div>
            <div>
              <p class="text-xs text-stone-400">{t.footer.callToday}</p>
              <p class="font-semibold text-white" dir="ltr">{business.phone}</p>
            </div>
          </a>
        </div>

        <!-- Location map -->
        <div class="relative overflow-hidden rounded-2xl border border-white/10 shadow-lg shadow-brand-950/50 ring-1 ring-white/5">
          <iframe
            title={t.footer.mapTitle}
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4590.851548168535!2d54.488540900000004!3d24.3528127!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3e5e410059169567%3A0x4fe013e18ee8b93d!2sDUCT%20MASTERS%20Air%20Conditioners%20Requisites%20Manufacturing!5e1!3m2!1sen!2sin!4v1786692528679!5m2!1sen!2sin"
            width="100%"
            height="256"
            style="border:0; display:block;"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            class="h-56 w-full lg:h-64"
          ></iframe>
          <a
            href={business.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="absolute bottom-3 end-3 inline-flex items-center gap-1.5 rounded-lg bg-brand-950/80 px-3 py-2 text-xs font-semibold text-white backdrop-blur-sm ring-1 ring-white/15 transition-colors hover:bg-brand-900"
          >
            <Icon name="lucide:navigation" class="size-3.5 text-accent-400" />
            {t.footer.directions}
          </a>
        </div>
      </div>
    </div>

    <!-- Link columns -->
    <div class="grid gap-10 pt-10 sm:grid-cols-2 lg:grid-cols-5">
      <!-- Column 1: Services -->
      <div class="lg:col-span-2">
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-wider text-stone-500">{t.footer.servicesHeading}</h3>
        <div class="grid gap-2.5 sm:grid-cols-2">
          {getServices(lang).map((service) => (
            <a href={serviceUrl(service.slug, lang)} class="text-sm text-stone-400 transition-colors hover:text-white flex min-h-6 items-center gap-2 group">
              <Icon name="lucide:chevron-right" class={chevron} />
              {service.shortName}
            </a>
          ))}
        </div>
      </div>

      <!-- Column 2: Service Areas -->
      <div>
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-wider text-stone-500">{t.footer.areasHeading}</h3>
        <ul class="space-y-2.5">
          {getAreas(lang).filter(a => a.featured).map((area) => (
            <li>
              <a href={areaUrl(area.slug, lang)} class="text-sm text-stone-400 transition-colors hover:text-white flex min-h-6 items-center gap-2 group">
                <Icon name="lucide:chevron-right" class={chevron} />
                {area.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Company -->
      <div>
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-wider text-stone-500">{t.footer.companyHeading}</h3>
        <ul class="space-y-2.5">
          {companyLinks.map((l) => (
            <li><a href={path(l.href)} class="text-sm text-stone-400 transition-colors hover:text-white flex min-h-6 items-center gap-2 group"><Icon name="lucide:chevron-right" class={chevron} />{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Contact -->
      <div>
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-wider text-stone-500">{t.footer.contactHeading}</h3>
        <ul class="space-y-3">
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:map-pin" class="mt-0.5 size-4 shrink-0 text-stone-500" />
            <span class="text-sm text-stone-400">{biz.address.street}{lang === 'ar' ? '، ' : ', '}{biz.address.city}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:phone" class="mt-0.5 size-4 shrink-0 text-stone-500" />
            <a href={business.phoneHref} class="inline-flex min-h-6 items-center text-sm text-stone-400 transition-colors hover:text-white" dir="ltr">{business.phone}</a>
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:smartphone" class="mt-0.5 size-4 shrink-0 text-stone-500" />
            <a href={`tel:${business.phoneSecondary.replace(/\s/g, '')}`} class="inline-flex min-h-6 items-center text-sm text-stone-400 transition-colors hover:text-white" dir="ltr">{business.phoneSecondary}</a>
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:mail" class="mt-0.5 size-4 shrink-0 text-stone-500" />
            <a href={`mailto:${business.email}`} class="inline-flex min-h-6 items-center text-sm text-stone-400 transition-colors hover:text-white">{business.email}</a>
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:clock" class="mt-0.5 size-4 shrink-0 text-stone-500" />
            <div class="text-sm text-stone-400">
              {biz.hours.map((schedule) => (
                <p>{schedule.days}: {schedule.hours}</p>
              ))}
            </div>
          </li>
        </ul>

        <!-- WhatsApp CTA -->
        <a
          href={business.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 rounded-lg bg-green-700 px-4 py-2.5 text-sm font-medium text-white transition-all hover:bg-green-600"
        >
          <Icon name="lucide:message-circle" class="size-4" />
          <span>{t.footer.chatWhatsapp}</span>
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 sm:flex-row">
      <p class="text-xs text-stone-600">
        &copy; {new Date().getFullYear()} {business.legalName}. {t.footer.rights}
      </p>
      <div class="flex items-center gap-4 text-xs text-stone-600">
        <span>{t.footer.keyword}</span>
        <span class="text-stone-700">|</span>
        <a href="https://gnext.ae" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-6 items-center transition-colors hover:text-stone-400">{t.footer.poweredBy}</a>
      </div>
    </div>
  </div>
</footer>
